{
  "$defs": {
    "DistributionKind": {
      "description": "Declared distribution family. Describes uncertainty; never samples.",
      "enum": [
        "uniform",
        "normal",
        "lognormal",
        "triangular",
        "discrete",
        "unspecified"
      ],
      "title": "DistributionKind",
      "type": "string"
    },
    "JsonValue": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "description": "A declared uncertainty about a target; distribution metadata only.",
  "properties": {
    "distribution": {
      "$ref": "#/$defs/DistributionKind",
      "default": "unspecified"
    },
    "identifier": {
      "title": "Identifier",
      "type": "string"
    },
    "metadata": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Metadata",
      "type": "object"
    },
    "notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Notes"
    },
    "parameters": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Parameters",
      "type": "object"
    },
    "schema_version": {
      "default": "1.0.0",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "target": {
      "title": "Target",
      "type": "string"
    },
    "tenant_id": {
      "title": "Tenant Id",
      "type": "string"
    }
  },
  "required": [
    "identifier",
    "tenant_id",
    "target"
  ],
  "title": "UncertaintyDefinition",
  "type": "object"
}
