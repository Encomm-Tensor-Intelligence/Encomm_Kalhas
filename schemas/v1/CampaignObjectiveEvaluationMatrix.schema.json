{
  "$defs": {
    "ObjectiveObservationEvaluation": {
      "additionalProperties": false,
      "description": "One exact value-level objective evaluation of one campaign run.\n\nEvaluates one exact raw observed metric value against one\nobjective binding: the strategy/seed/objective positions and\nidentities, the metric identity and unit, the run identity and\ninput hash the value came from, the exact raw value (integers stay\nintegers, floats stay floats), the direction/target/weight/\ntolerance/scale snapshots, ``target_achieved`` (``None`` exactly\nwhen no target exists), the direction-aware ``signed_target_delta``\n(positive = adverse, zero = boundary, negative = acceptable), and\nthe non-negative normalized target violation\n``max(0, signed_target_delta) / normalization_scale``. When no\ntarget exists all three evaluation fields are ``None`` - no target\nis ever invented. All derived values must be finite; anything else\nis rejected. The evaluation is data only: nothing here aggregates,\nscores, ranks, or recommends.",
      "properties": {
        "direction": {
          "enum": [
            "minimize",
            "maximize",
            "reach"
          ],
          "title": "Direction",
          "type": "string"
        },
        "input_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Hash",
          "type": "string"
        },
        "metric_id": {
          "minLength": 1,
          "title": "Metric Id",
          "type": "string"
        },
        "metric_unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metric Unit"
        },
        "normalization_scale": {
          "title": "Normalization Scale",
          "type": "number"
        },
        "normalized_target_violation": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Normalized Target Violation"
        },
        "objective_id": {
          "minLength": 1,
          "title": "Objective Id",
          "type": "string"
        },
        "objective_position": {
          "minimum": 0,
          "title": "Objective Position",
          "type": "integer"
        },
        "raw_value": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            }
          ],
          "title": "Raw Value"
        },
        "reach_tolerance": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reach Tolerance"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "scenario_seed_id": {
          "minLength": 1,
          "title": "Scenario Seed Id",
          "type": "string"
        },
        "seed_position": {
          "minimum": 0,
          "title": "Seed Position",
          "type": "integer"
        },
        "sequence_position": {
          "minimum": 0,
          "title": "Sequence Position",
          "type": "integer"
        },
        "signed_target_delta": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Signed Target Delta"
        },
        "strategy_candidate_id": {
          "minLength": 1,
          "title": "Strategy Candidate Id",
          "type": "string"
        },
        "strategy_position": {
          "minimum": 0,
          "title": "Strategy Position",
          "type": "integer"
        },
        "target": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        },
        "target_achieved": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Achieved"
        },
        "weight": {
          "default": 1.0,
          "minimum": 0.0,
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "sequence_position",
        "strategy_position",
        "seed_position",
        "objective_position",
        "strategy_candidate_id",
        "scenario_seed_id",
        "objective_id",
        "metric_id",
        "run_id",
        "input_hash",
        "raw_value",
        "direction",
        "normalization_scale"
      ],
      "title": "ObjectiveObservationEvaluation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The deterministic objective-evaluation matrix of one completed 2.0.0 campaign.\n\nThe complete strategy x seed x objective evaluation of a completed\nruntime-2.0.0 campaign, derived exclusively from its completely\nverified Phase 21 ``CampaignMetricObservationMatrix`` and the exact\n``ScenarioEvaluationProfile`` embedded in the campaign's compiled\nworld: the campaign/scenario/world identity and world content hash,\nthe runtime version (always ``\"2.0.0\"``), the comparison mode\n(always ``identical_conditions``), the exact source matrix\nreference, the exact evaluation profile reference, the\nauthoritative scenario content hash, the exact ordered strategy,\nseed, and objective identifiers (objectives in exact\n``ScenarioSpec`` order - no lexical ordering requirement), and the\ncomplete cell tuple in the exact strategy-major, seed-minor,\nobjective-minor order. Every strategy/seed/objective position is in\nrange, every strategy x seed x objective triple appears exactly\nonce, sequence positions are contiguous from zero, and each cell's\nidentities match its authoritative positions. ``evaluated_at`` is\nthe authoritative Phase 21 matrix ``assembled_at`` - never the wall\nclock - and the identifier is independently derived from the\ncanonical campaign/world/runtime/source/profile identity, never\nfrom the content hash.\n\nThe matrix is exact value-level evaluation only: it performs no\naggregation, produces no probability, confidence, distribution,\nrisk, ranking, dominance, regret, preference, winner, evidence,\nrecommendation, or decision brief, and executes, replays, extracts,\nor stores nothing.",
  "properties": {
    "campaign_id": {
      "minLength": 1,
      "title": "Campaign Id",
      "type": "string"
    },
    "cells": {
      "items": {
        "$ref": "#/$defs/ObjectiveObservationEvaluation"
      },
      "minItems": 1,
      "title": "Cells",
      "type": "array"
    },
    "comparison_mode": {
      "const": "identical_conditions",
      "default": "identical_conditions",
      "title": "Comparison Mode",
      "type": "string"
    },
    "content_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Hash",
      "type": "string"
    },
    "evaluated_at": {
      "format": "date-time",
      "title": "Evaluated At",
      "type": "string"
    },
    "evaluation_profile_content_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Evaluation Profile Content Hash",
      "type": "string"
    },
    "evaluation_profile_id": {
      "minLength": 1,
      "title": "Evaluation Profile Id",
      "type": "string"
    },
    "identifier": {
      "title": "Identifier",
      "type": "string"
    },
    "ordered_objective_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Ordered Objective Ids",
      "type": "array"
    },
    "ordered_scenario_seed_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Ordered Scenario Seed Ids",
      "type": "array"
    },
    "ordered_strategy_candidate_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Ordered Strategy Candidate Ids",
      "type": "array"
    },
    "runtime_version": {
      "const": "2.0.0",
      "title": "Runtime Version",
      "type": "string"
    },
    "scenario_content_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Scenario Content Hash",
      "type": "string"
    },
    "scenario_id": {
      "minLength": 1,
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "source_metric_observation_matrix_content_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Metric Observation Matrix Content Hash",
      "type": "string"
    },
    "source_metric_observation_matrix_id": {
      "minLength": 1,
      "title": "Source Metric Observation Matrix Id",
      "type": "string"
    },
    "tenant_id": {
      "title": "Tenant Id",
      "type": "string"
    },
    "world_content_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "World Content Hash",
      "type": "string"
    },
    "world_version_id": {
      "minLength": 1,
      "title": "World Version Id",
      "type": "string"
    }
  },
  "required": [
    "identifier",
    "tenant_id",
    "campaign_id",
    "scenario_id",
    "world_version_id",
    "world_content_hash",
    "runtime_version",
    "source_metric_observation_matrix_id",
    "source_metric_observation_matrix_content_hash",
    "evaluation_profile_id",
    "evaluation_profile_content_hash",
    "scenario_content_hash",
    "ordered_strategy_candidate_ids",
    "ordered_scenario_seed_ids",
    "ordered_objective_ids",
    "cells",
    "content_hash",
    "evaluated_at"
  ],
  "title": "CampaignObjectiveEvaluationMatrix",
  "type": "object"
}
