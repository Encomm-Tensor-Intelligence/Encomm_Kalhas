{
  "additionalProperties": false,
  "description": "Provenance manifest of an exact replay of a trajectory execution.\n\nBinds the replay to the run, campaign, and the stored\n``RunTrajectoryExecution`` artifact (by its deterministic\nidentifier), records the verified world/strategy/seed identities, the\ntrajectory runtime version, the run input hash, and the exact ordered\nplan-set hash, and attests that the independently regenerated\nexecution hash equals the recorded expected execution hash with\n``replay_classification`` always ``\"exact\"``. ``replayed_at`` is\ndeterministic (the recorded RunPlan creation time) - never the wall\nclock.",
  "properties": {
    "campaign_id": {
      "title": "Campaign Id",
      "type": "string"
    },
    "expected_execution_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Expected Execution Hash",
      "type": "string"
    },
    "identifier": {
      "title": "Identifier",
      "type": "string"
    },
    "input_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Hash",
      "type": "string"
    },
    "recomputed_execution_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Recomputed Execution Hash",
      "type": "string"
    },
    "replay_classification": {
      "const": "exact",
      "default": "exact",
      "title": "Replay Classification",
      "type": "string"
    },
    "replayed_at": {
      "format": "date-time",
      "title": "Replayed At",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "run_trajectory_execution_id": {
      "title": "Run Trajectory Execution Id",
      "type": "string"
    },
    "runtime_version": {
      "const": "2.0.0",
      "title": "Runtime Version",
      "type": "string"
    },
    "scenario_seed_id": {
      "title": "Scenario Seed Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "strategy_candidate_id": {
      "title": "Strategy Candidate Id",
      "type": "string"
    },
    "tenant_id": {
      "title": "Tenant Id",
      "type": "string"
    },
    "trajectory_plan_set_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Trajectory Plan Set Hash",
      "type": "string"
    },
    "world_version_id": {
      "title": "World Version Id",
      "type": "string"
    }
  },
  "required": [
    "identifier",
    "tenant_id",
    "run_id",
    "campaign_id",
    "run_trajectory_execution_id",
    "world_version_id",
    "strategy_candidate_id",
    "scenario_seed_id",
    "runtime_version",
    "input_hash",
    "trajectory_plan_set_hash",
    "expected_execution_hash",
    "recomputed_execution_hash",
    "replayed_at"
  ],
  "title": "RunTrajectoryReplayManifest",
  "type": "object"
}
