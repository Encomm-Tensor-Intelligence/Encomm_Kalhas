{
  "$defs": {
    "Assumption": {
      "additionalProperties": false,
      "description": "A declared assumption about the world or a strategy.",
      "properties": {
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "identifier": {
          "title": "Identifier",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Metadata",
          "type": "object"
        },
        "statement": {
          "title": "Statement",
          "type": "string"
        }
      },
      "required": [
        "identifier",
        "statement",
        "confidence"
      ],
      "title": "Assumption",
      "type": "object"
    },
    "Constraint": {
      "additionalProperties": false,
      "description": "A declared constraint on the scenario or on candidate strategies.",
      "properties": {
        "description": {
          "title": "Description",
          "type": "string"
        },
        "hard": {
          "default": true,
          "title": "Hard",
          "type": "boolean"
        },
        "identifier": {
          "title": "Identifier",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "identifier",
        "description"
      ],
      "title": "Constraint",
      "type": "object"
    },
    "JsonValue": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "MetricDefinition": {
      "additionalProperties": false,
      "description": "Declared definition of a measurable outcome metric.",
      "properties": {
        "aggregation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Aggregation"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "identifier": {
          "title": "Identifier",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        }
      },
      "required": [
        "identifier",
        "name"
      ],
      "title": "MetricDefinition",
      "type": "object"
    },
    "Objective": {
      "additionalProperties": false,
      "description": "A declared objective with direction, optional target, and weight.",
      "properties": {
        "description": {
          "title": "Description",
          "type": "string"
        },
        "direction": {
          "$ref": "#/$defs/ObjectiveDirection"
        },
        "identifier": {
          "title": "Identifier",
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        },
        "weight": {
          "default": 1.0,
          "minimum": 0.0,
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "identifier",
        "description",
        "direction"
      ],
      "title": "Objective",
      "type": "object"
    },
    "ObjectiveDirection": {
      "description": "Declared direction of an objective.",
      "enum": [
        "maximize",
        "minimize",
        "reach"
      ],
      "title": "ObjectiveDirection",
      "type": "string"
    },
    "TimeHorizon": {
      "additionalProperties": false,
      "description": "A declared time horizon for a scenario.",
      "properties": {
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        },
        "resolution": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolution"
        },
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "TimeHorizon",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A declarative scenario specification (domain-neutral).\n\nScenario-level input does not own campaign seed assignment; seed\nensemble ownership belongs to ``CampaignSpec``. A scenario describes\nintent only: its world is produced later by the deterministic world\ncompiler, which emits an immutable ``WorldVersion`` carrying this\nscenario's identifier as ``source_scenario_id``.",
  "properties": {
    "assumptions": {
      "items": {
        "$ref": "#/$defs/Assumption"
      },
      "title": "Assumptions",
      "type": "array"
    },
    "constraints": {
      "items": {
        "$ref": "#/$defs/Constraint"
      },
      "title": "Constraints",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "description": {
      "default": "",
      "title": "Description",
      "type": "string"
    },
    "identifier": {
      "title": "Identifier",
      "type": "string"
    },
    "metadata": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Metadata",
      "type": "object"
    },
    "metrics": {
      "items": {
        "$ref": "#/$defs/MetricDefinition"
      },
      "title": "Metrics",
      "type": "array"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "objectives": {
      "items": {
        "$ref": "#/$defs/Objective"
      },
      "title": "Objectives",
      "type": "array"
    },
    "schema_version": {
      "default": "1.0.0",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "tenant_id": {
      "title": "Tenant Id",
      "type": "string"
    },
    "time_horizon": {
      "$ref": "#/$defs/TimeHorizon"
    }
  },
  "required": [
    "identifier",
    "tenant_id",
    "name",
    "created_at",
    "objectives",
    "time_horizon"
  ],
  "title": "ScenarioSpec",
  "type": "object"
}
