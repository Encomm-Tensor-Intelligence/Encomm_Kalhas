{
  "$defs": {
    "Assumption": {
      "additionalProperties": false,
      "description": "A declared assumption about the world or a strategy.",
      "properties": {
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "identifier": {
          "title": "Identifier",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Metadata",
          "type": "object"
        },
        "statement": {
          "title": "Statement",
          "type": "string"
        }
      },
      "required": [
        "identifier",
        "statement",
        "confidence"
      ],
      "title": "Assumption",
      "type": "object"
    },
    "JsonValue": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "ObservationRequirement": {
      "additionalProperties": false,
      "description": "A required observation of a metric.",
      "properties": {
        "description": {
          "title": "Description",
          "type": "string"
        },
        "metric_id": {
          "title": "Metric Id",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        }
      },
      "required": [
        "metric_id",
        "description"
      ],
      "title": "ObservationRequirement",
      "type": "object"
    },
    "PolicyDeclaration": {
      "additionalProperties": false,
      "description": "A declared policy: summary plus declarative rules and parameters.",
      "properties": {
        "rules": {
          "items": {
            "$ref": "#/$defs/PolicyRule"
          },
          "title": "Rules",
          "type": "array"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "summary"
      ],
      "title": "PolicyDeclaration",
      "type": "object"
    },
    "PolicyRule": {
      "additionalProperties": false,
      "description": "One declarative rule of a policy. Human-readable; never executable.",
      "properties": {
        "identifier": {
          "title": "Identifier",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Parameters",
          "type": "object"
        },
        "statement": {
          "title": "Statement",
          "type": "string"
        }
      },
      "required": [
        "identifier",
        "statement"
      ],
      "title": "PolicyRule",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A declared strategy candidate: policy, required observations, assumptions.\n\nRepresents a strategy without running it - no execution, no simulation.",
  "properties": {
    "assumptions": {
      "items": {
        "$ref": "#/$defs/Assumption"
      },
      "title": "Assumptions",
      "type": "array"
    },
    "identifier": {
      "title": "Identifier",
      "type": "string"
    },
    "metadata": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Metadata",
      "type": "object"
    },
    "policy": {
      "$ref": "#/$defs/PolicyDeclaration"
    },
    "required_observations": {
      "items": {
        "$ref": "#/$defs/ObservationRequirement"
      },
      "title": "Required Observations",
      "type": "array"
    },
    "schema_version": {
      "default": "1.0.0",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "strategy_version": {
      "title": "Strategy Version",
      "type": "string"
    },
    "tenant_id": {
      "title": "Tenant Id",
      "type": "string"
    }
  },
  "required": [
    "identifier",
    "tenant_id",
    "strategy_version",
    "policy"
  ],
  "title": "StrategyCandidate",
  "type": "object"
}
