{
  "$defs": {
    "ExternalObservationInputEntry": {
      "additionalProperties": false,
      "description": "One immutable accepted external input value.\n\nThe deterministic entry identifier, the referenced declaration's\nidentifier and content hash, the logical observation id, the external\nchannel id, the non-negative source step index, the exact value kind\n(``\"integer\"`` or ``\"number\"``), an optional unit, and an exact finite\nvalue. Integer entries require an exact ``int``; number entries accept\nan exact finite ``int`` or ``float``. Booleans and any numeric\ncoercion fail.",
      "properties": {
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "external_channel_id": {
          "minLength": 1,
          "title": "External Channel Id",
          "type": "string"
        },
        "identifier": {
          "minLength": 1,
          "title": "Identifier",
          "type": "string"
        },
        "observation_id": {
          "minLength": 1,
          "title": "Observation Id",
          "type": "string"
        },
        "runtime_observation_declaration_content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Runtime Observation Declaration Content Hash",
          "type": "string"
        },
        "runtime_observation_declaration_id": {
          "minLength": 1,
          "title": "Runtime Observation Declaration Id",
          "type": "string"
        },
        "source_step_index": {
          "minimum": 0,
          "title": "Source Step Index",
          "type": "integer"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "value": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            }
          ],
          "title": "Value"
        },
        "value_kind": {
          "enum": [
            "integer",
            "number"
          ],
          "title": "Value Kind",
          "type": "string"
        }
      },
      "required": [
        "identifier",
        "runtime_observation_declaration_id",
        "runtime_observation_declaration_content_hash",
        "observation_id",
        "external_channel_id",
        "source_step_index",
        "value_kind",
        "value",
        "content_hash"
      ],
      "title": "ExternalObservationInputEntry",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Immutable authority of accepted external/offline input values.\n\nCarries the deterministic external-input bundle identifier, tenant and\nschema version, campaign/scenario identity, the world and\nscenario-seed identities with their content hashes, the exact runtime\nversion ``4.0.0``, a non-empty canonically ordered tuple of immutable\nexternal input entries, the self-covering ``content_hash``, and the\ndeterministic caller-supplied ``accepted_at``. Entry ``value = ExactNumeric``\nkinds must agree exactly with the declared entry kind. External bundle\nvalues never receive fresh runtime noise; cross-authority verification\nagainst stored declarations is deliberately deferred to later services.",
  "properties": {
    "accepted_at": {
      "format": "date-time",
      "title": "Accepted At",
      "type": "string"
    },
    "campaign_id": {
      "minLength": 1,
      "title": "Campaign Id",
      "type": "string"
    },
    "content_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Hash",
      "type": "string"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/ExternalObservationInputEntry"
      },
      "minItems": 1,
      "title": "Entries",
      "type": "array"
    },
    "identifier": {
      "title": "Identifier",
      "type": "string"
    },
    "runtime_version": {
      "const": "4.0.0",
      "title": "Runtime Version",
      "type": "string"
    },
    "scenario_id": {
      "minLength": 1,
      "title": "Scenario Id",
      "type": "string"
    },
    "scenario_seed_id": {
      "minLength": 1,
      "title": "Scenario Seed Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "seed_content_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Seed Content Hash",
      "type": "string"
    },
    "tenant_id": {
      "title": "Tenant Id",
      "type": "string"
    },
    "world_content_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "World Content Hash",
      "type": "string"
    },
    "world_version_id": {
      "minLength": 1,
      "title": "World Version Id",
      "type": "string"
    }
  },
  "required": [
    "identifier",
    "tenant_id",
    "campaign_id",
    "scenario_id",
    "world_version_id",
    "world_content_hash",
    "scenario_seed_id",
    "seed_content_hash",
    "runtime_version",
    "entries",
    "content_hash",
    "accepted_at"
  ],
  "title": "ExternalObservationInputBundle",
  "type": "object"
}
