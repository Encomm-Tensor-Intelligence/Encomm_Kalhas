{
  "$defs": {
    "CampaignState": {
      "description": "The campaign lifecycle states.\n\nThe allowed transitions live in\n``kalhas/application/campaign_lifecycle.py``.",
      "enum": [
        "draft",
        "validated",
        "compiled",
        "running",
        "complete",
        "failed",
        "cancelled"
      ],
      "title": "CampaignState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "A snapshot of a campaign's lifecycle state.",
  "properties": {
    "campaign_id": {
      "title": "Campaign Id",
      "type": "string"
    },
    "changed_at": {
      "format": "date-time",
      "title": "Changed At",
      "type": "string"
    },
    "identifier": {
      "title": "Identifier",
      "type": "string"
    },
    "message": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Message"
    },
    "schema_version": {
      "default": "1.0.0",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/CampaignState"
    },
    "tenant_id": {
      "title": "Tenant Id",
      "type": "string"
    }
  },
  "required": [
    "identifier",
    "tenant_id",
    "campaign_id",
    "state",
    "changed_at"
  ],
  "title": "CampaignStatus",
  "type": "object"
}
