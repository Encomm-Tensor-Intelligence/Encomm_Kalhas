      "type": "array"
    },
    "decision_scope": {
      "const": "decision_support_only",
      "title": "Decision Scope",
      "type": "string"
    },
    "declared_at": {
      "format": "date-time",
      "title": "Declared At",
      "type": "string"
    },
    "identifier": {
      "title": "Identifier",
      "type": "string"
    },
    "intended_uses": {
      "items": {
        "$ref": "#/$defs/ModelPackIntendedUse"
      },
      "minItems": 1,
      "title": "Intended Uses",
      "type": "array"
    },
    "limitations": {
