{
  "$defs": {
    "RealizationCampaignTrajectoryRunCell": {
      "additionalProperties": false,
      "description": "One run of the deterministic realization-aware campaign trajectory matrix.\n\nA pure structural reference cell: the run's sequence, strategy, and\nseed positions; the run and run-plan identity; the strategy and seed\nidentities; the run input hash; the verified runtime-3\ntrajectory-execution artifact reference (deterministic identifier and\ncontent hash) with its exact ordered plan-set hash; the ordered result\ncontent hashes of that execution; and the world realization identity\nand content hash that supplied the run's realized initial states. It\ncarries no state snapshots, no transition guards or target values, no\nstrategy policy content, no outcome values, no evidence, no ranking or\nscore, and no explanations or hidden reasoning.",
      "properties": {
        "input_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Hash",
          "type": "string"
        },
        "realization_run_trajectory_execution_content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Realization Run Trajectory Execution Content Hash",
          "type": "string"
        },
        "realization_run_trajectory_execution_id": {
          "minLength": 1,
          "title": "Realization Run Trajectory Execution Id",
          "type": "string"
        },
        "result_content_hashes": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Result Content Hashes",
          "type": "array"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "run_plan_id": {
          "minLength": 1,
          "title": "Run Plan Id",
          "type": "string"
        },
        "scenario_seed_id": {
          "minLength": 1,
          "title": "Scenario Seed Id",
          "type": "string"
        },
        "seed_position": {
          "minimum": 0,
          "title": "Seed Position",
          "type": "integer"
        },
        "sequence_position": {
          "minimum": 0,
          "title": "Sequence Position",
          "type": "integer"
        },
        "strategy_candidate_id": {
          "minLength": 1,
          "title": "Strategy Candidate Id",
          "type": "string"
        },
        "strategy_position": {
          "minimum": 0,
          "title": "Strategy Position",
          "type": "integer"
        },
        "trajectory_plan_set_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Trajectory Plan Set Hash",
          "type": "string"
        },
        "world_realization_content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "World Realization Content Hash",
          "type": "string"
        },
        "world_realization_id": {
          "minLength": 1,
          "title": "World Realization Id",
          "type": "string"
        }
      },
      "required": [
        "sequence_position",
        "strategy_position",
        "seed_position",
        "run_id",
        "run_plan_id",
        "strategy_candidate_id",
        "scenario_seed_id",
        "input_hash",
        "realization_run_trajectory_execution_id",
        "realization_run_trajectory_execution_content_hash",
        "trajectory_plan_set_hash",
        "result_content_hashes",
        "world_realization_id",
        "world_realization_content_hash"
      ],
      "title": "RealizationCampaignTrajectoryRunCell",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The deterministic realization-aware trajectory matrix of one completed 3.0.0 campaign.\n\nThe complete Cartesian product of the campaign's ordered strategy\ncandidates and its ordered shared seed ensemble, in the exact\nauthoritative RunPlan order (strategy-major, seed-minor): every\nstrategy appears once for every seed, every strategy receives the\nidentical ordered seed identifiers and the identical seed-aligned\nworld realizations, and every cell binds to its exact stored RunPlan,\nverified ``RealizationRunTrajectoryExecution``, and seed-aligned world\nrealization. The matrix is a structural comparison artifact only - it\nnever ranks strategies, never interprets state values, and never\nproduces outcomes, evidence, or recommendations. ``assembled_at`` is\nderived from the recorded campaign ``created_at`` - never the wall\nclock - and the identifier is deterministic from the campaign\nidentity, the world identity, and the runtime version.",
  "properties": {
    "assembled_at": {
      "format": "date-time",
      "title": "Assembled At",
      "type": "string"
    },
    "campaign_id": {
      "minLength": 1,
      "title": "Campaign Id",
      "type": "string"
    },
    "cells": {
      "items": {
        "$ref": "#/$defs/RealizationCampaignTrajectoryRunCell"
      },
      "minItems": 1,
      "title": "Cells",
      "type": "array"
    },
    "comparison_mode": {
      "const": "identical_conditions",
      "default": "identical_conditions",
      "title": "Comparison Mode",
      "type": "string"
    },
    "content_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Hash",
      "type": "string"
    },
    "identifier": {
      "title": "Identifier",
      "type": "string"
    },
    "ordered_scenario_seed_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Ordered Scenario Seed Ids",
      "type": "array"
    },
    "ordered_strategy_candidate_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Ordered Strategy Candidate Ids",
      "type": "array"
    },
    "ordered_world_realization_content_hashes": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Ordered World Realization Content Hashes",
      "type": "array"
    },
    "ordered_world_realization_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Ordered World Realization Ids",
      "type": "array"
    },
    "runtime_version": {
      "const": "3.0.0",
      "title": "Runtime Version",
      "type": "string"
    },
    "scenario_id": {
      "minLength": 1,
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "tenant_id": {
      "title": "Tenant Id",
      "type": "string"
    },
    "world_content_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "World Content Hash",
      "type": "string"
    },
    "world_version_id": {
      "minLength": 1,
      "title": "World Version Id",
      "type": "string"
    }
  },
  "required": [
    "identifier",
    "tenant_id",
    "campaign_id",
    "scenario_id",
    "world_version_id",
    "world_content_hash",
    "runtime_version",
    "ordered_strategy_candidate_ids",
    "ordered_scenario_seed_ids",
    "ordered_world_realization_ids",
    "ordered_world_realization_content_hashes",
    "cells",
    "content_hash",
    "assembled_at"
  ],
  "title": "RealizationCampaignTrajectoryMatrix",
  "type": "object"
}
