{
  "$defs": {
    "Assumption": {
      "additionalProperties": false,
      "description": "A declared assumption about the world or a strategy.",
      "properties": {
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "identifier": {
          "title": "Identifier",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Metadata",
          "type": "object"
        },
        "statement": {
          "title": "Statement",
          "type": "string"
        }
      },
      "required": [
        "identifier",
        "statement",
        "confidence"
      ],
      "title": "Assumption",
      "type": "object"
    },
    "DomainStateFieldDefinition": {
      "additionalProperties": false,
      "description": "One declarative state field of a scenario-bound domain pack.\n\nThe field declares its stable identifier, a description, its value\nkind, an initial value that must exactly match the kind, an optional\ntuple of allowed values (all matching the kind, canonically unique,\nand including the initial value), and optional JSON-compatible\nmetadata. It is data only: no formulas, expressions, policies,\ncallbacks, or executable content can be expressed.",
      "properties": {
        "allowed_values": {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Allowed Values",
          "type": "array"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "identifier": {
          "minLength": 1,
          "title": "Identifier",
          "type": "string"
        },
        "initial_value": {
          "$ref": "#/$defs/JsonValue"
        },
        "metadata": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Metadata",
          "type": "object"
        },
        "value_kind": {
          "$ref": "#/$defs/StateValueKind"
        }
      },
      "required": [
        "identifier",
        "description",
        "value_kind",
        "initial_value"
      ],
      "title": "DomainStateFieldDefinition",
      "type": "object"
    },
    "DomainStateModel": {
      "additionalProperties": false,
      "description": "Immutable declarative state schema for a scenario-bound domain pack.\n\nThe model is anchored to an existing ``DomainPackBinding``: every\nidentity field (binding id, manifest id, logical ``pack_id``, semantic\n``pack_version``, authoritative manifest content hash) is copied from\nstored immutable records - never from client input. The stable\n``state_model_id`` is a non-empty client-chosen name; the model's\ndeterministic identifier is hash-derived from the canonical\nscenario/manifest/state-model identity, and ``content_hash`` is the\nSHA-256 digest of the canonical serialized model content excluding\n``content_hash`` itself.\n\n``state_fields`` are canonicalized by identifier: equivalent caller\norderings produce the same canonical model, hash, and world snapshot.\nThe model is frozen by contract and is never updated, deleted,\nreplaced, or re-declared; it defines state fields only and never\nexecutes, interprets, or derives anything.",
      "properties": {
        "binding_id": {
          "title": "Binding Id",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "declared_at": {
          "format": "date-time",
          "title": "Declared At",
          "type": "string"
        },
        "identifier": {
          "title": "Identifier",
          "type": "string"
        },
        "manifest_content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Content Hash",
          "type": "string"
        },
        "manifest_id": {
          "title": "Manifest Id",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Metadata",
          "type": "object"
        },
        "pack_id": {
          "title": "Pack Id",
          "type": "string"
        },
        "pack_version": {
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Pack Version",
          "type": "string"
        },
        "scenario_id": {
          "title": "Scenario Id",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0.0",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Schema Version",
          "type": "string"
        },
        "state_fields": {
          "items": {
            "$ref": "#/$defs/DomainStateFieldDefinition"
          },
          "title": "State Fields",
          "type": "array"
        },
        "state_model_id": {
          "minLength": 1,
          "title": "State Model Id",
          "type": "string"
        },
        "tenant_id": {
          "title": "Tenant Id",
          "type": "string"
        }
      },
      "required": [
        "identifier",
        "tenant_id",
        "scenario_id",
        "binding_id",
        "manifest_id",
        "pack_id",
        "pack_version",
        "manifest_content_hash",
        "state_model_id",
        "content_hash",
        "declared_at"
      ],
      "title": "DomainStateModel",
      "type": "object"
    },
    "DomainStateTransition": {
      "additionalProperties": false,
      "description": "Immutable declarative specification of one possible state change.\n\nThe transition is anchored to an existing ``DomainStateModel``:\nevery identity field (binding id, manifest id, logical ``pack_id``,\nsemantic ``pack_version``, authoritative manifest content hash, and\nthe referenced state model's authoritative content hash) is copied\nfrom stored immutable records - never from client input. The stable\n``transition_id`` is a non-empty client-chosen name; the\ntransition's deterministic identifier is hash-derived from the\ncanonical scenario/manifest/state-model/transition identity, and\n``content_hash`` is the SHA-256 digest of the canonical serialized\ntransition content excluding ``content_hash`` itself.\n\n``guard_values`` and ``target_values`` are canonicalized by field\nidentifier: equivalent caller key orderings produce the same\ncanonical transition, hash, and world snapshot. A guard is only a\ndeclarative equality condition and a target is only a declarative\nintended state patch - neither is ever evaluated, compared, or\napplied here. ``target_values`` must be non-empty; ``guard_values``\nmay be empty (an unconditional transition). The transition is frozen\nby contract and is never updated, deleted, replaced, or re-declared;\nit specifies possible transitions only and never executes anything.",
      "properties": {
        "binding_id": {
          "title": "Binding Id",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "declared_at": {
          "format": "date-time",
          "title": "Declared At",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "guard_values": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Guard Values",
          "type": "object"
        },
        "identifier": {
          "title": "Identifier",
          "type": "string"
        },
        "manifest_content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Content Hash",
          "type": "string"
        },
        "manifest_id": {
          "title": "Manifest Id",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Metadata",
          "type": "object"
        },
        "pack_id": {
          "title": "Pack Id",
          "type": "string"
        },
        "pack_version": {
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Pack Version",
          "type": "string"
        },
        "scenario_id": {
          "title": "Scenario Id",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0.0",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Schema Version",
          "type": "string"
        },
        "state_model_content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "State Model Content Hash",
          "type": "string"
        },
        "state_model_id": {
          "title": "State Model Id",
          "type": "string"
        },
        "target_values": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Target Values",
          "type": "object"
        },
        "tenant_id": {
          "title": "Tenant Id",
          "type": "string"
        },
        "transition_id": {
          "minLength": 1,
          "title": "Transition Id",
          "type": "string"
        }
      },
      "required": [
        "identifier",
        "tenant_id",
        "scenario_id",
        "binding_id",
        "manifest_id",
        "pack_id",
        "pack_version",
        "manifest_content_hash",
        "state_model_id",
        "state_model_content_hash",
        "transition_id",
        "description",
        "content_hash",
        "declared_at"
      ],
      "title": "DomainStateTransition",
      "type": "object"
    },
    "JsonValue": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "ObservationRequirement": {
      "additionalProperties": false,
      "description": "A required observation of a metric.",
      "properties": {
        "description": {
          "title": "Description",
          "type": "string"
        },
        "metric_id": {
          "title": "Metric Id",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        }
      },
      "required": [
        "metric_id",
        "description"
      ],
      "title": "ObservationRequirement",
      "type": "object"
    },
    "PolicyDeclaration": {
      "additionalProperties": false,
      "description": "A declared policy: summary plus declarative rules and parameters.",
      "properties": {
        "rules": {
          "items": {
            "$ref": "#/$defs/PolicyRule"
          },
          "title": "Rules",
          "type": "array"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "summary"
      ],
      "title": "PolicyDeclaration",
      "type": "object"
    },
    "PolicyRule": {
      "additionalProperties": false,
      "description": "One declarative rule of a policy. Human-readable; never executable.",
      "properties": {
        "identifier": {
          "title": "Identifier",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Parameters",
          "type": "object"
        },
        "statement": {
          "title": "Statement",
          "type": "string"
        }
      },
      "required": [
        "identifier",
        "statement"
      ],
      "title": "PolicyRule",
      "type": "object"
    },
    "StateValueKind": {
      "description": "The declared value kind of one state field.\n\n``json`` accepts any JSON-compatible value (the widest kind). The\nkinds are structural only: they describe data shapes, never behavior.",
      "enum": [
        "string",
        "integer",
        "number",
        "boolean",
        "json"
      ],
      "title": "StateValueKind",
      "type": "string"
    },
    "StrategyCandidate": {
      "additionalProperties": false,
      "description": "A declared strategy candidate: policy, required observations, assumptions.\n\nRepresents a strategy without running it - no execution, no simulation.",
      "properties": {
        "assumptions": {
          "items": {
            "$ref": "#/$defs/Assumption"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "identifier": {
          "title": "Identifier",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Metadata",
          "type": "object"
        },
        "policy": {
          "$ref": "#/$defs/PolicyDeclaration"
        },
        "required_observations": {
          "items": {
            "$ref": "#/$defs/ObservationRequirement"
          },
          "title": "Required Observations",
          "type": "array"
        },
        "schema_version": {
          "default": "1.0.0",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Schema Version",
          "type": "string"
        },
        "strategy_version": {
          "title": "Strategy Version",
          "type": "string"
        },
        "tenant_id": {
          "title": "Tenant Id",
          "type": "string"
        }
      },
      "required": [
        "identifier",
        "tenant_id",
        "strategy_version",
        "policy"
      ],
      "title": "StrategyCandidate",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Authoritative trajectory-plan request sent across the LEGION boundary.\n\nBuilt **only by KALHAS** from verified stored records: the prepared\ncampaign identity, the verified compiled world identity and content\nhash, the exact stored ``StrategyCandidate`` snapshot with its full\ncontent hash, the exact ``DomainStateModel`` snapshot from the\ncompiled world, and the canonical tuple of that model's available\n``DomainStateTransition`` snapshots (non-empty). The deterministic\nidentifier is derived by KALHAS from the canonical\ncampaign/world/strategy/state-model identity; LEGION must not supply\nor choose it.",
  "properties": {
    "available_transitions": {
      "items": {
        "$ref": "#/$defs/DomainStateTransition"
      },
      "title": "Available Transitions",
      "type": "array"
    },
    "campaign_id": {
      "title": "Campaign Id",
      "type": "string"
    },
    "identifier": {
      "title": "Identifier",
      "type": "string"
    },
    "requested_at": {
      "format": "date-time",
      "title": "Requested At",
      "type": "string"
    },
    "scenario_id": {
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "state_model": {
      "$ref": "#/$defs/DomainStateModel"
    },
    "strategy_candidate": {
      "$ref": "#/$defs/StrategyCandidate"
    },
    "strategy_content_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Strategy Content Hash",
      "type": "string"
    },
    "tenant_id": {
      "title": "Tenant Id",
      "type": "string"
    },
    "world_content_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "World Content Hash",
      "type": "string"
    },
    "world_version_id": {
      "title": "World Version Id",
      "type": "string"
    }
  },
  "required": [
    "identifier",
    "tenant_id",
    "campaign_id",
    "scenario_id",
    "world_version_id",
    "world_content_hash",
    "strategy_candidate",
    "strategy_content_hash",
    "state_model",
    "requested_at"
  ],
  "title": "StrategyTrajectoryPlanRequest",
  "type": "object"
}
