{
  "additionalProperties": false,
  "description": "Provenance manifest of an exact replay of a completed run.\n\nReplay regenerates the deterministic event stream from recorded inputs\nonly; the recomputed hash must equal the stored expected event hash.",
  "properties": {
    "campaign_id": {
      "title": "Campaign Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "expected_event_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Expected Event Hash",
      "type": "string"
    },
    "identifier": {
      "title": "Identifier",
      "type": "string"
    },
    "input_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Hash",
      "type": "string"
    },
    "replay_classification": {
      "const": "exact",
      "default": "exact",
      "title": "Replay Classification",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "runtime_version": {
      "title": "Runtime Version",
      "type": "string"
    },
    "scenario_seed_id": {
      "title": "Scenario Seed Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "strategy_candidate_id": {
      "title": "Strategy Candidate Id",
      "type": "string"
    },
    "tenant_id": {
      "title": "Tenant Id",
      "type": "string"
    },
    "world_version_id": {
      "title": "World Version Id",
      "type": "string"
    }
  },
  "required": [
    "identifier",
    "tenant_id",
    "run_id",
    "campaign_id",
    "world_version_id",
    "strategy_candidate_id",
    "scenario_seed_id",
    "runtime_version",
    "input_hash",
    "expected_event_hash",
    "created_at"
  ],
  "title": "ReplayManifest",
  "type": "object"
}
