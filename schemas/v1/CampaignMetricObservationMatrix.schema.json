{
  "$defs": {
    "CampaignMetricObservationCell": {
      "additionalProperties": false,
      "description": "One authoritative campaign run of the metric-observation matrix.\n\nA pure comparison cell: the run's sequence, strategy, and seed\npositions; the run and run-plan identity; the strategy and seed\nidentities; the run input hash; the verified trajectory-execution\nreference (deterministic identifier and content hash); the verified\nPhase 20 ``RunMetricObservationSet`` reference (deterministic\nidentifier and content hash); and the exact ordered tuple of Phase\n20 ``RunMetricObservationValue`` records - raw values and provenance\npreserved exactly, never aggregated, normalized, converted, or\ninterpreted. It carries no state snapshots, no transition guards or\ntarget values, no strategy policy content, no outcomes, no\nevidence, no ranking or score, and no explanations or hidden\nreasoning.",
      "properties": {
        "input_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Hash",
          "type": "string"
        },
        "metric_observation_set_content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Metric Observation Set Content Hash",
          "type": "string"
        },
        "metric_observation_set_id": {
          "minLength": 1,
          "title": "Metric Observation Set Id",
          "type": "string"
        },
        "observations": {
          "items": {
            "$ref": "#/$defs/RunMetricObservationValue"
          },
          "title": "Observations",
          "type": "array"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "run_plan_id": {
          "minLength": 1,
          "title": "Run Plan Id",
          "type": "string"
        },
        "scenario_seed_id": {
          "minLength": 1,
          "title": "Scenario Seed Id",
          "type": "string"
        },
        "seed_position": {
          "minimum": 0,
          "title": "Seed Position",
          "type": "integer"
        },
        "sequence_position": {
          "minimum": 0,
          "title": "Sequence Position",
          "type": "integer"
        },
        "strategy_candidate_id": {
          "minLength": 1,
          "title": "Strategy Candidate Id",
          "type": "string"
        },
        "strategy_position": {
          "minimum": 0,
          "title": "Strategy Position",
          "type": "integer"
        },
        "trajectory_execution_content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Trajectory Execution Content Hash",
          "type": "string"
        },
        "trajectory_execution_id": {
          "minLength": 1,
          "title": "Trajectory Execution Id",
          "type": "string"
        }
      },
      "required": [
        "sequence_position",
        "strategy_position",
        "seed_position",
        "run_id",
        "run_plan_id",
        "strategy_candidate_id",
        "scenario_seed_id",
        "input_hash",
        "trajectory_execution_id",
        "trajectory_execution_content_hash",
        "metric_observation_set_id",
        "metric_observation_set_content_hash",
        "observations"
      ],
      "title": "CampaignMetricObservationCell",
      "type": "object"
    },
    "RunMetricObservationValue": {
      "additionalProperties": false,
      "description": "One immutable raw metric observation extracted from a verified final state.\n\nCarries the exact provenance required to prove where the value came\nfrom: the metric identity and its unit (copied from the authoritative\nembedded ``ScenarioSpec`` when declared), the observation binding\nidentifier and content hash, the manifest and state-model\nidentity/content hashes, the observed state field and its\nauthoritative numeric value kind, the observation point (exactly\n``\"final_state\"``), the trajectory-plan identity/content hash and the\nexact result content hash required to locate the authoritative final\nstate inside the verified ``RunTrajectoryExecution``, and the exact\nfinite ``raw_value`` read from ``final_state[state_field_id]`` - with\nno normalization, scaling, transformation, or unit conversion.\n\nThe value is raw extraction data only: nothing here aggregates,\nscores, ranks, produces outcomes/evidence/recommendations, or\nexecutes anything.",
      "properties": {
        "binding_content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Binding Content Hash",
          "type": "string"
        },
        "binding_id": {
          "minLength": 1,
          "title": "Binding Id",
          "type": "string"
        },
        "manifest_id": {
          "minLength": 1,
          "title": "Manifest Id",
          "type": "string"
        },
        "metric_id": {
          "minLength": 1,
          "title": "Metric Id",
          "type": "string"
        },
        "metric_unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metric Unit"
        },
        "observation_point": {
          "const": "final_state",
          "default": "final_state",
          "title": "Observation Point",
          "type": "string"
        },
        "raw_value": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            }
          ],
          "title": "Raw Value"
        },
        "state_field_id": {
          "minLength": 1,
          "title": "State Field Id",
          "type": "string"
        },
        "state_field_value_kind": {
          "enum": [
            "integer",
            "number"
          ],
          "title": "State Field Value Kind",
          "type": "string"
        },
        "state_model_content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "State Model Content Hash",
          "type": "string"
        },
        "state_model_id": {
          "minLength": 1,
          "title": "State Model Id",
          "type": "string"
        },
        "state_model_identifier": {
          "minLength": 1,
          "title": "State Model Identifier",
          "type": "string"
        },
        "trajectory_plan_content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Trajectory Plan Content Hash",
          "type": "string"
        },
        "trajectory_plan_id": {
          "minLength": 1,
          "title": "Trajectory Plan Id",
          "type": "string"
        },
        "trajectory_result_content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Trajectory Result Content Hash",
          "type": "string"
        }
      },
      "required": [
        "metric_id",
        "binding_id",
        "binding_content_hash",
        "manifest_id",
        "state_model_identifier",
        "state_model_id",
        "state_model_content_hash",
        "state_field_id",
        "state_field_value_kind",
        "trajectory_plan_id",
        "trajectory_plan_content_hash",
        "trajectory_result_content_hash",
        "raw_value"
      ],
      "title": "RunMetricObservationValue",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The deterministic campaign metric-observation matrix of one completed 2.0.0 campaign.\n\nThe complete Cartesian product of the campaign's ordered strategy\ncandidates and its ordered shared seed ensemble, in the exact\nauthoritative RunPlan order (strategy-major, seed-minor): every\nstrategy appears once for every seed, every strategy receives the\nidentical ordered seed identifiers, and every cell carries the\nverified Phase 20 ``RunMetricObservationSet`` reference and the\nexact raw observation values of its run. The matrix is a\ncomparison-ready raw observation and provenance artifact only - it\nnever aggregates observations, calculates outcomes or\ndistributions, scores or ranks strategies, decides that one\nstrategy is better, or produces evidence, recommendations, or\ndecision briefs. ``assembled_at`` is derived from the recorded\ncampaign ``created_at`` - never the wall clock - and the identifier\nis deterministic from the campaign identity, the world identity,\nand the runtime version.",
  "properties": {
    "assembled_at": {
      "format": "date-time",
      "title": "Assembled At",
      "type": "string"
    },
    "campaign_id": {
      "minLength": 1,
      "title": "Campaign Id",
      "type": "string"
    },
    "cells": {
      "items": {
        "$ref": "#/$defs/CampaignMetricObservationCell"
      },
      "minItems": 1,
      "title": "Cells",
      "type": "array"
    },
    "comparison_mode": {
      "const": "identical_conditions",
      "default": "identical_conditions",
      "title": "Comparison Mode",
      "type": "string"
    },
    "content_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Hash",
      "type": "string"
    },
    "identifier": {
      "title": "Identifier",
      "type": "string"
    },
    "ordered_metric_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Ordered Metric Ids",
      "type": "array"
    },
    "ordered_scenario_seed_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Ordered Scenario Seed Ids",
      "type": "array"
    },
    "ordered_strategy_candidate_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Ordered Strategy Candidate Ids",
      "type": "array"
    },
    "runtime_version": {
      "const": "2.0.0",
      "title": "Runtime Version",
      "type": "string"
    },
    "scenario_id": {
      "minLength": 1,
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "tenant_id": {
      "title": "Tenant Id",
      "type": "string"
    },
    "world_content_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "World Content Hash",
      "type": "string"
    },
    "world_version_id": {
      "minLength": 1,
      "title": "World Version Id",
      "type": "string"
    }
  },
  "required": [
    "identifier",
    "tenant_id",
    "campaign_id",
    "scenario_id",
    "world_version_id",
    "world_content_hash",
    "runtime_version",
    "ordered_strategy_candidate_ids",
    "ordered_scenario_seed_ids",
    "ordered_metric_ids",
    "cells",
    "content_hash",
    "assembled_at"
  ],
  "title": "CampaignMetricObservationMatrix",
  "type": "object"
}
