{
  "$defs": {
    "ValidationIssue": {
      "additionalProperties": false,
      "description": "One issue found during validation.",
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "loc": {
          "default": [],
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ]
          },
          "title": "Loc",
          "type": "array"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/ValidationSeverity",
          "default": "error"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ValidationIssue",
      "type": "object"
    },
    "ValidationSeverity": {
      "description": "Severity of a validation issue.",
      "enum": [
        "error",
        "warning",
        "info"
      ],
      "title": "ValidationSeverity",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "The result of validating a scenario or another subject.",
  "properties": {
    "identifier": {
      "title": "Identifier",
      "type": "string"
    },
    "issues": {
      "items": {
        "$ref": "#/$defs/ValidationIssue"
      },
      "title": "Issues",
      "type": "array"
    },
    "schema_version": {
      "default": "1.0.0",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "subject_id": {
      "title": "Subject Id",
      "type": "string"
    },
    "tenant_id": {
      "title": "Tenant Id",
      "type": "string"
    },
    "valid": {
      "title": "Valid",
      "type": "boolean"
    },
    "validated_at": {
      "format": "date-time",
      "title": "Validated At",
      "type": "string"
    }
  },
  "required": [
    "identifier",
    "tenant_id",
    "subject_id",
    "valid",
    "validated_at"
  ],
  "title": "ValidationReport",
  "type": "object"
}
