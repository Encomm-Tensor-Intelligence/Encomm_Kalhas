{
  "$defs": {
    "AdditiveUniformObservationNoise": {
      "additionalProperties": false,
      "description": "Declared additive uniform observation noise over exact finite bounds.\n\nDeclares one additive uniform noise draw with exact finite\n``lower_bound`` and ``upper_bound`` (``lower_bound <= upper_bound``),\nthe frozen sampler/quantization provenance literals, and an exact\n``draw_count`` of ``1``. This slice declares noise only; it never\nsamples or evaluates it.",
      "properties": {
        "draw_count": {
          "const": 1,
          "title": "Draw Count",
          "type": "integer"
        },
        "kind": {
          "const": "additive_uniform",
          "title": "Kind",
          "type": "string"
        },
        "lower_bound": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            }
          ],
          "title": "Lower Bound"
        },
        "quantization_fraction_bits": {
          "const": 64,
          "title": "Quantization Fraction Bits",
          "type": "integer"
        },
        "quantization_policy": {
          "const": "rational-round-half-even",
          "title": "Quantization Policy",
          "type": "string"
        },
        "sampler_version": {
          "const": "sha256-counter-v1",
          "title": "Sampler Version",
          "type": "string"
        },
        "upper_bound": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            }
          ],
          "title": "Upper Bound"
        }
      },
      "required": [
        "kind",
        "lower_bound",
        "upper_bound",
        "sampler_version",
        "quantization_policy",
        "quantization_fraction_bits",
        "draw_count"
      ],
      "title": "AdditiveUniformObservationNoise",
      "type": "object"
    },
    "ExternalObservationSource": {
      "additionalProperties": false,
      "description": "A stable external/offline input channel.\n\nThe source of an immutable external input: a stable\n``external_channel_id`` and the copied numeric value kind. External\ninputs never receive fresh runtime noise.",
      "properties": {
        "external_channel_id": {
          "minLength": 1,
          "title": "External Channel Id",
          "type": "string"
        },
        "external_value_kind": {
          "enum": [
            "integer",
            "number"
          ],
          "title": "External Value Kind",
          "type": "string"
        },
        "kind": {
          "const": "external_input",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "external_channel_id",
        "external_value_kind"
      ],
      "title": "ExternalObservationSource",
      "type": "object"
    },
    "JsonValue": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "NoObservationNoise": {
      "additionalProperties": false,
      "description": "The closed ``none`` observation-noise declaration.\n\nNo fresh runtime noise is drawn: ``draw_count`` is exactly ``0``.",
      "properties": {
        "draw_count": {
          "const": 0,
          "title": "Draw Count",
          "type": "integer"
        },
        "kind": {
          "const": "none",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "draw_count"
      ],
      "title": "NoObservationNoise",
      "type": "object"
    },
    "ObservationTiming": {
      "additionalProperties": false,
      "description": "The strict cadence that determines causal availability by step.\n\nAn observation declares ``start_step >= 0``, ``every_n_steps >= 1``,\nand ``delay_steps >= 0``. It is scheduled at step ``S`` exactly when\n``S >= start_step`` and ``(S - start_step) % every_n_steps == 0``. An\nobservation sourced at step ``S`` becomes available at ``S +\ndelay_steps``. No wall-clock value determines availability.",
      "properties": {
        "delay_steps": {
          "minimum": 0,
          "title": "Delay Steps",
          "type": "integer"
        },
        "every_n_steps": {
          "minimum": 1,
          "title": "Every N Steps",
          "type": "integer"
        },
        "start_step": {
          "minimum": 0,
          "title": "Start Step",
          "type": "integer"
        }
      },
      "required": [
        "start_step",
        "every_n_steps",
        "delay_steps"
      ],
      "title": "ObservationTiming",
      "type": "object"
    },
    "StateFieldObservationSource": {
      "additionalProperties": false,
      "description": "Authoritative copied provenance of one visible numeric state field.\n\nEvery provenance field is copied from stored immutable records and\nlocates one explicitly visible numeric state field: the manifest,\nthe deterministic state-model identifier, the logical state-model id\nand its content hash, the state-field id, and the copied numeric\nfield value kind.",
      "properties": {
        "kind": {
          "const": "state_field",
          "title": "Kind",
          "type": "string"
        },
        "manifest_id": {
          "minLength": 1,
          "title": "Manifest Id",
          "type": "string"
        },
        "state_field_id": {
          "minLength": 1,
          "title": "State Field Id",
          "type": "string"
        },
        "state_field_value_kind": {
          "enum": [
            "integer",
            "number"
          ],
          "title": "State Field Value Kind",
          "type": "string"
        },
        "state_model_content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "State Model Content Hash",
          "type": "string"
        },
        "state_model_id": {
          "minLength": 1,
          "title": "State Model Id",
          "type": "string"
        },
        "state_model_identifier": {
          "minLength": 1,
          "title": "State Model Identifier",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "manifest_id",
        "state_model_identifier",
        "state_model_id",
        "state_model_content_hash",
        "state_field_id",
        "state_field_value_kind"
      ],
      "title": "StateFieldObservationSource",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Immutable causal observation declaration for runtime 4.0.0.\n\nDeclares one observation: its scenario, world identity and content\nhash, a stable logical ``observation_id``, the runtime version\n``4.0.0``, one closed observation source, the observed numeric value\nkind, an optional declared unit, the timing/cadence, the\nobservation-noise declaration, and the explicit ``missing_behavior``\n(exactly ``\"false\"`` or ``\"error\"``). ``declared_at`` is the\ndeterministic caller-supplied timestamp and ``metadata`` holds only\nfinite JSON-compatible values. External-input sources require noise\nkind ``\"none\"``; without noise ``observed_value_kind`` must equal the\nsource value kind; additive noise produces ``observed_value_kind``\n``\"number\"``. No hidden conversion, clipping, or tolerance is\nexpressible.",
  "properties": {
    "content_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Hash",
      "type": "string"
    },
    "declared_at": {
      "format": "date-time",
      "title": "Declared At",
      "type": "string"
    },
    "identifier": {
      "title": "Identifier",
      "type": "string"
    },
    "metadata": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Metadata",
      "type": "object"
    },
    "missing_behavior": {
      "enum": [
        "false",
        "error"
      ],
      "title": "Missing Behavior",
      "type": "string"
    },
    "noise": {
      "discriminator": {
        "mapping": {
          "additive_uniform": "#/$defs/AdditiveUniformObservationNoise",
          "none": "#/$defs/NoObservationNoise"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/NoObservationNoise"
        },
        {
          "$ref": "#/$defs/AdditiveUniformObservationNoise"
        }
      ],
      "title": "Noise"
    },
    "observation_id": {
      "minLength": 1,
      "title": "Observation Id",
      "type": "string"
    },
    "observation_source": {
      "discriminator": {
        "mapping": {
          "external_input": "#/$defs/ExternalObservationSource",
          "state_field": "#/$defs/StateFieldObservationSource"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/StateFieldObservationSource"
        },
        {
          "$ref": "#/$defs/ExternalObservationSource"
        }
      ],
      "title": "Observation Source"
    },
    "observed_value_kind": {
      "enum": [
        "integer",
        "number"
      ],
      "title": "Observed Value Kind",
      "type": "string"
    },
    "runtime_version": {
      "const": "4.0.0",
      "title": "Runtime Version",
      "type": "string"
    },
    "scenario_id": {
      "minLength": 1,
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "tenant_id": {
      "title": "Tenant Id",
      "type": "string"
    },
    "timing": {
      "$ref": "#/$defs/ObservationTiming"
    },
    "unit": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Unit"
    },
    "world_content_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "World Content Hash",
      "type": "string"
    },
    "world_version_id": {
      "minLength": 1,
      "title": "World Version Id",
      "type": "string"
    }
  },
  "required": [
    "identifier",
    "tenant_id",
    "scenario_id",
    "world_version_id",
    "world_content_hash",
    "observation_id",
    "runtime_version",
    "observation_source",
    "observed_value_kind",
    "timing",
    "noise",
    "missing_behavior",
    "content_hash",
    "declared_at"
  ],
  "title": "RuntimeObservationDeclaration",
  "type": "object"
}
