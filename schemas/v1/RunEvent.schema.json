{
  "$defs": {
    "EventMetadata": {
      "additionalProperties": false,
      "description": "Declared metadata attached to a run event.",
      "properties": {
        "details": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Details",
          "type": "object"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        }
      },
      "title": "EventMetadata",
      "type": "object"
    },
    "JsonValue": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "RunEventKind": {
      "description": "Declared kinds of run events.\n\nThe three structural kinds (``RUN_STARTED``, ``STRATEGY_DECLARATION_RECORDED``,\n``RUN_COMPLETED``) form the deterministic structural event stream emitted\nby the structural runtime for every executed run.",
      "enum": [
        "state_change",
        "observation",
        "decision",
        "milestone",
        "error",
        "note",
        "run_started",
        "strategy_declaration_recorded",
        "run_completed"
      ],
      "title": "RunEventKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "One event of a run.\n\n``sequence`` is the strictly increasing per-run ordering used for\ndeterministic replay; ``simulation_time`` is the time inside the\nsimulated world (derived deterministically from the recorded scenario\nhorizon), while ``created_at`` is when the event was recorded (derived\ndeterministically from recorded run inputs). Every event carries the\nrun, campaign, world, strategy, and seed references. Structural events\nnever contain domain outcome values, hidden reasoning, or executable\npolicy content.",
  "properties": {
    "campaign_id": {
      "title": "Campaign Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "identifier": {
      "title": "Identifier",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/RunEventKind",
      "default": "note"
    },
    "metadata": {
      "$ref": "#/$defs/EventMetadata"
    },
    "payload": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Payload",
      "type": "object"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "scenario_seed_id": {
      "title": "Scenario Seed Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "sequence": {
      "minimum": 0,
      "title": "Sequence",
      "type": "integer"
    },
    "simulation_time": {
      "format": "date-time",
      "title": "Simulation Time",
      "type": "string"
    },
    "strategy_candidate_id": {
      "title": "Strategy Candidate Id",
      "type": "string"
    },
    "tenant_id": {
      "title": "Tenant Id",
      "type": "string"
    },
    "world_version_id": {
      "title": "World Version Id",
      "type": "string"
    }
  },
  "required": [
    "identifier",
    "tenant_id",
    "run_id",
    "campaign_id",
    "world_version_id",
    "strategy_candidate_id",
    "scenario_seed_id",
    "sequence",
    "simulation_time",
    "created_at"
  ],
  "title": "RunEvent",
  "type": "object"
}
