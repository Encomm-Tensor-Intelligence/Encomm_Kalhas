{
  "$defs": {
    "JsonValue": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "description": "An immutable world-model version.\n\nFrozen by contract: attribute assignment raises after validation.\nSupports a parent version id so world models evolve as a version chain.\nCarries provenance: the source scenario, the compiler version, and the\ncontent hash that make compilation reproducible.",
  "properties": {
    "compiler_version": {
      "title": "Compiler Version",
      "type": "string"
    },
    "content_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Hash",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "identifier": {
      "title": "Identifier",
      "type": "string"
    },
    "metadata": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Metadata",
      "type": "object"
    },
    "parent_version_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Version Id"
    },
    "schema_version": {
      "default": "1.0.0",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "source_scenario_id": {
      "title": "Source Scenario Id",
      "type": "string"
    },
    "tenant_id": {
      "title": "Tenant Id",
      "type": "string"
    },
    "world": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "World",
      "type": "object"
    }
  },
  "required": [
    "identifier",
    "tenant_id",
    "source_scenario_id",
    "compiler_version",
    "content_hash",
    "created_at"
  ],
  "title": "WorldVersion",
  "type": "object"
}
