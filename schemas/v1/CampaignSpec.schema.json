{
  "$defs": {
    "JsonValue": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "ScenarioSeed": {
      "additionalProperties": false,
      "description": "Reproducible, serializable seed material.\n\nContains only declared seed data - no random sampling, no executables.",
      "properties": {
        "algorithm": {
          "default": "deterministic",
          "title": "Algorithm",
          "type": "string"
        },
        "derived_from": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Derived From"
        },
        "identifier": {
          "title": "Identifier",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Metadata",
          "type": "object"
        },
        "schema_version": {
          "default": "1.0.0",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Schema Version",
          "type": "string"
        },
        "seed_value": {
          "minLength": 1,
          "title": "Seed Value",
          "type": "string"
        },
        "tenant_id": {
          "title": "Tenant Id",
          "type": "string"
        }
      },
      "required": [
        "identifier",
        "tenant_id",
        "seed_value"
      ],
      "title": "ScenarioSeed",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A campaign comparing strategy candidates on one scenario and world.\n\nFair comparison is a structural invariant, not a caller choice: every\nstrategy candidate receives the exact same ordered seed identifiers (the\nshared ``seed_ensemble``) and equivalent observation permissions. Seed\nensemble ownership belongs to the campaign, never to scenario-level\ninput, and the seed ensemble is the sole source of run multiplicity.\nCampaigns run against an already compiled immutable world\n(``world_version_id``). Every seed must belong to the campaign tenant.",
  "properties": {
    "comparison_mode": {
      "const": "identical_conditions",
      "default": "identical_conditions",
      "title": "Comparison Mode",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "identifier": {
      "title": "Identifier",
      "type": "string"
    },
    "metadata": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Metadata",
      "type": "object"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "scenario_id": {
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "seed_ensemble": {
      "items": {
        "$ref": "#/$defs/ScenarioSeed"
      },
      "minItems": 1,
      "title": "Seed Ensemble",
      "type": "array"
    },
    "strategy_candidate_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Strategy Candidate Ids",
      "type": "array"
    },
    "tenant_id": {
      "title": "Tenant Id",
      "type": "string"
    },
    "world_version_id": {
      "title": "World Version Id",
      "type": "string"
    }
  },
  "required": [
    "identifier",
    "tenant_id",
    "name",
    "scenario_id",
    "world_version_id",
    "strategy_candidate_ids",
    "seed_ensemble",
    "created_at"
  ],
  "title": "CampaignSpec",
  "type": "object"
}
