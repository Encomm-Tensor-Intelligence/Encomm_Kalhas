{
  "$defs": {
    "Assumption": {
      "additionalProperties": false,
      "description": "A declared assumption about the world or a strategy.",
      "properties": {
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "identifier": {
          "title": "Identifier",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Metadata",
          "type": "object"
        },
        "statement": {
          "title": "Statement",
          "type": "string"
        }
      },
      "required": [
        "identifier",
        "statement",
        "confidence"
      ],
      "title": "Assumption",
      "type": "object"
    },
    "DistributionKind": {
      "description": "Declared distribution family. Describes uncertainty; never samples.",
      "enum": [
        "uniform",
        "normal",
        "lognormal",
        "triangular",
        "discrete",
        "unspecified"
      ],
      "title": "DistributionKind",
      "type": "string"
    },
    "DistributionSummary": {
      "additionalProperties": false,
      "description": "Declared summary of an outcome distribution (no sampling, no code).",
      "properties": {
        "kind": {
          "$ref": "#/$defs/DistributionKind",
          "default": "unspecified"
        },
        "lower_quantile": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lower Quantile"
        },
        "mean": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mean"
        },
        "median": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Median"
        },
        "parameters": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Parameters",
          "type": "object"
        },
        "samples": {
          "items": {
            "type": "number"
          },
          "title": "Samples",
          "type": "array"
        },
        "upper_quantile": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Upper Quantile"
        }
      },
      "title": "DistributionSummary",
      "type": "object"
    },
    "EvidenceReference": {
      "additionalProperties": false,
      "description": "A pointer to recorded evidence (declared provenance, no data access).",
      "properties": {
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "identifier": {
          "title": "Identifier",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Metadata",
          "type": "object"
        },
        "recorded_at": {
          "format": "date-time",
          "title": "Recorded At",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0.0",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Schema Version",
          "type": "string"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "source_kind": {
          "title": "Source Kind",
          "type": "string"
        },
        "tenant_id": {
          "title": "Tenant Id",
          "type": "string"
        }
      },
      "required": [
        "identifier",
        "tenant_id",
        "source_kind",
        "source_id",
        "recorded_at"
      ],
      "title": "EvidenceReference",
      "type": "object"
    },
    "JsonValue": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "MetricOutcome": {
      "additionalProperties": false,
      "description": "Outcome of one metric: point estimate plus declared distribution.",
      "properties": {
        "distribution": {
          "anyOf": [
            {
              "$ref": "#/$defs/DistributionSummary"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "metric_id": {
          "title": "Metric Id",
          "type": "string"
        },
        "observed_values": {
          "items": {
            "type": "number"
          },
          "title": "Observed Values",
          "type": "array"
        },
        "point_estimate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Point Estimate"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        }
      },
      "required": [
        "metric_id"
      ],
      "title": "MetricOutcome",
      "type": "object"
    },
    "RiskStatement": {
      "additionalProperties": false,
      "description": "A declared risk with likelihood and impact; never a single score.",
      "properties": {
        "description": {
          "title": "Description",
          "type": "string"
        },
        "identifier": {
          "title": "Identifier",
          "type": "string"
        },
        "impact": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Impact",
          "type": "number"
        },
        "likelihood": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Likelihood",
          "type": "number"
        },
        "mitigations": {
          "items": {
            "type": "string"
          },
          "title": "Mitigations",
          "type": "array"
        }
      },
      "required": [
        "identifier",
        "description",
        "likelihood",
        "impact"
      ],
      "title": "RiskStatement",
      "type": "object"
    },
    "UncertaintyStatement": {
      "additionalProperties": false,
      "description": "A declared uncertainty about a target, with distribution metadata.",
      "properties": {
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "distribution": {
          "$ref": "#/$defs/DistributionKind",
          "default": "unspecified"
        },
        "parameters": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Parameters",
          "type": "object"
        },
        "target": {
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "target"
      ],
      "title": "UncertaintyStatement",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Outcome of one run: distributions, risks, assumptions, and evidence.",
  "properties": {
    "assumptions": {
      "items": {
        "$ref": "#/$defs/Assumption"
      },
      "title": "Assumptions",
      "type": "array"
    },
    "evidence_references": {
      "items": {
        "$ref": "#/$defs/EvidenceReference"
      },
      "title": "Evidence References",
      "type": "array"
    },
    "identifier": {
      "title": "Identifier",
      "type": "string"
    },
    "metrics": {
      "items": {
        "$ref": "#/$defs/MetricOutcome"
      },
      "title": "Metrics",
      "type": "array"
    },
    "produced_at": {
      "format": "date-time",
      "title": "Produced At",
      "type": "string"
    },
    "risks": {
      "items": {
        "$ref": "#/$defs/RiskStatement"
      },
      "title": "Risks",
      "type": "array"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "scenario_id": {
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "strategy_candidate_id": {
      "title": "Strategy Candidate Id",
      "type": "string"
    },
    "tenant_id": {
      "title": "Tenant Id",
      "type": "string"
    },
    "uncertainty": {
      "items": {
        "$ref": "#/$defs/UncertaintyStatement"
      },
      "title": "Uncertainty",
      "type": "array"
    }
  },
  "required": [
    "identifier",
    "tenant_id",
    "run_id",
    "scenario_id",
    "strategy_candidate_id",
    "produced_at"
  ],
  "title": "OutcomeVector",
  "type": "object"
}
