{
  "$defs": {
    "DenominatorEntry": {
      "additionalProperties": false,
      "properties": {
        "series": {
          "minLength": 1,
          "title": "Series",
          "type": "string"
        },
        "value": {
          "minimum": 1,
          "title": "Value",
          "type": "integer"
        },
        "year": {
          "maximum": 9999,
          "minimum": 1,
          "title": "Year",
          "type": "integer"
        }
      },
      "required": [
        "series",
        "year",
        "value"
      ],
      "title": "DenominatorEntry",
      "type": "object"
    },
    "FlowSumOperator": {
      "additionalProperties": false,
      "properties": {
        "flow": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Flow",
          "type": "string"
        },
        "op": {
          "const": "flow_sum",
          "title": "Op",
          "type": "string"
        }
      },
      "required": [
        "op",
        "flow"
      ],
      "title": "FlowSumOperator",
      "type": "object"
    },
    "JsonValue": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "PerHundredKOperator": {
      "additionalProperties": false,
      "properties": {
        "inner": {
          "discriminator": {
            "mapping": {
              "flow_sum": "#/$defs/FlowSumOperator",
              "stock_sum": "#/$defs/StockSumOperator"
            },
            "propertyName": "op"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/StockSumOperator"
            },
            {
              "$ref": "#/$defs/FlowSumOperator"
            }
          ],
          "title": "Inner"
        },
        "op": {
          "const": "per_100k",
          "title": "Op",
          "type": "string"
        }
      },
      "required": [
        "op",
        "inner"
      ],
      "title": "PerHundredKOperator",
      "type": "object"
    },
    "StockSumOperator": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "stock_sum",
          "title": "Op",
          "type": "string"
        },
        "stocks": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]{0,63}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Stocks",
          "type": "array"
        }
      },
      "required": [
        "op",
        "stocks"
      ],
      "title": "StockSumOperator",
      "type": "object"
    },
    "TargetObservation": {
      "additionalProperties": false,
      "properties": {
        "operator": {
          "discriminator": {
            "mapping": {
              "flow_sum": "#/$defs/FlowSumOperator",
              "per_100k": "#/$defs/PerHundredKOperator",
              "stock_sum": "#/$defs/StockSumOperator"
            },
            "propertyName": "op"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/StockSumOperator"
            },
            {
              "$ref": "#/$defs/FlowSumOperator"
            },
            {
              "$ref": "#/$defs/PerHundredKOperator"
            }
          ],
          "title": "Operator"
        },
        "target_path": {
          "title": "Target Path",
          "type": "string"
        },
        "variant_id": {
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Variant Id",
          "type": "string"
        }
      },
      "required": [
        "target_path",
        "variant_id",
        "operator"
      ],
      "title": "TargetObservation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "An immutable binding of declared observations to a locked protocol.",
  "properties": {
    "assumptions": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Assumptions",
      "type": "array"
    },
    "binding_id": {
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "title": "Binding Id",
      "type": "string"
    },
    "binding_version": {
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Binding Version",
      "type": "string"
    },
    "content_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Hash",
      "type": "string"
    },
    "declared_at": {
      "format": "date-time",
      "title": "Declared At",
      "type": "string"
    },
    "denominators": {
      "items": {
        "$ref": "#/$defs/DenominatorEntry"
      },
      "title": "Denominators",
      "type": "array"
    },
    "identifier": {
      "title": "Identifier",
      "type": "string"
    },
    "metadata": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Metadata",
      "type": "object"
    },
    "observations": {
      "items": {
        "$ref": "#/$defs/TargetObservation"
      },
      "minItems": 1,
      "title": "Observations",
      "type": "array"
    },
    "operator_vocabulary_version": {
      "const": "1.0.0",
      "title": "Operator Vocabulary Version",
      "type": "string"
    },
    "pack_id": {
      "minLength": 1,
      "title": "Pack Id",
      "type": "string"
    },
    "pack_version": {
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Pack Version",
      "type": "string"
    },
    "payload": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Payload",
      "type": "object"
    },
    "protocol_content_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Protocol Content Hash",
      "type": "string"
    },
    "protocol_manifest_id": {
      "minLength": 1,
      "title": "Protocol Manifest Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "tenant_id": {
      "title": "Tenant Id",
      "type": "string"
    }
  },
  "required": [
    "identifier",
    "tenant_id",
    "binding_id",
    "binding_version",
    "pack_id",
    "pack_version",
    "protocol_manifest_id",
    "protocol_content_hash",
    "operator_vocabulary_version",
    "observations",
    "denominators",
    "payload",
    "assumptions",
    "declared_at",
    "content_hash"
  ],
  "title": "ModelPackAuthoringBinding",
  "type": "object"
}
