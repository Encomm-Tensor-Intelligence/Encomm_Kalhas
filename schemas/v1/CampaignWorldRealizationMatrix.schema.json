{
  "$defs": {
    "JsonValue": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "RealizedStateFieldValue": {
      "additionalProperties": false,
      "description": "One realized initial-state override for one targeted field.\n\nPart of the complete override delta: exactly one entry per\nuncertainty binding, none for untargeted base-state fields. The\nvalue is an exact finite numeric that satisfies the authoritative\ntarget kind.",
      "properties": {
        "state_field_id": {
          "minLength": 1,
          "title": "State Field Id",
          "type": "string"
        },
        "state_model_identifier": {
          "minLength": 1,
          "title": "State Model Identifier",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/JsonValue"
        }
      },
      "required": [
        "state_model_identifier",
        "state_field_id",
        "value"
      ],
      "title": "RealizedStateFieldValue",
      "type": "object"
    },
    "SampledStateFieldValue": {
      "additionalProperties": false,
      "description": "One sampled value of one targeted state field.\n\n``sampled_raw_value`` is the exact finite distribution output\n**before** clipping and rounding; for an integer target it may\nlegitimately be a float (booleans and non-finite values are\nrejected). ``realized_value`` is the final value after clipping and\nrounding and must exactly match the authoritative target kind\n(integer targets always finish as exact ``int``; number targets may\nfinish as ``int`` or ``float`` according to the representation\npreservation rules). ``draw_index`` is the starting global\ndigest-word index and ``draw_count`` is the exact word consumption\nof the distribution kind (1 for uniform/triangular/discrete, 2 for\nnormal/lognormal).",
      "properties": {
        "binding_id": {
          "minLength": 1,
          "title": "Binding Id",
          "type": "string"
        },
        "distribution_kind": {
          "enum": [
            "uniform",
            "triangular",
            "normal",
            "lognormal",
            "discrete"
          ],
          "title": "Distribution Kind",
          "type": "string"
        },
        "draw_count": {
          "minimum": 1,
          "title": "Draw Count",
          "type": "integer"
        },
        "draw_index": {
          "minimum": 0,
          "title": "Draw Index",
          "type": "integer"
        },
        "manifest_id": {
          "minLength": 1,
          "title": "Manifest Id",
          "type": "string"
        },
        "quantization_fraction_bits": {
          "const": 64,
          "title": "Quantization Fraction Bits",
          "type": "integer"
        },
        "quantization_policy": {
          "const": "rational-round-half-even",
          "title": "Quantization Policy",
          "type": "string"
        },
        "realized_value": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            }
          ],
          "title": "Realized Value"
        },
        "sampled_raw_value": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            }
          ],
          "title": "Sampled Raw Value"
        },
        "sampler_version": {
          "const": "sha256-counter-v1",
          "title": "Sampler Version",
          "type": "string"
        },
        "scenario_id": {
          "minLength": 1,
          "title": "Scenario Id",
          "type": "string"
        },
        "state_field_id": {
          "minLength": 1,
          "title": "State Field Id",
          "type": "string"
        },
        "state_field_value_kind": {
          "enum": [
            "integer",
            "number"
          ],
          "title": "State Field Value Kind",
          "type": "string"
        },
        "state_model_id": {
          "minLength": 1,
          "title": "State Model Id",
          "type": "string"
        },
        "state_model_identifier": {
          "minLength": 1,
          "title": "State Model Identifier",
          "type": "string"
        },
        "uncertainty_binding_content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Uncertainty Binding Content Hash",
          "type": "string"
        },
        "uncertainty_binding_identifier": {
          "minLength": 1,
          "title": "Uncertainty Binding Identifier",
          "type": "string"
        }
      },
      "required": [
        "uncertainty_binding_identifier",
        "uncertainty_binding_content_hash",
        "scenario_id",
        "binding_id",
        "manifest_id",
        "state_model_identifier",
        "state_model_id",
        "state_field_id",
        "state_field_value_kind",
        "distribution_kind",
        "sampler_version",
        "quantization_policy",
        "quantization_fraction_bits",
        "draw_index",
        "draw_count",
        "sampled_raw_value",
        "realized_value"
      ],
      "title": "SampledStateFieldValue",
      "type": "object"
    },
    "WorldRealization": {
      "additionalProperties": false,
      "description": "One strategy-independent realization of one world under one shared seed.\n\nDeterministically derived from the compiled world, the embedded\nuncertainty model (or its absence), and the exact campaign seed:\nthe ordered sampled values in canonical binding order, the complete\nrealized initial-state override delta, the world and seed\nidentity/hash provenance, the uncertainty-model identity/hash (both\n``None`` exactly when the world has no model), the frozen\nsampler/quantization provenance, the deterministic independently\nderived identifier (covering world and seed identities *and* their\ncontent hashes, the model identity/hash or the explicit ``absent``\nmarker, and the sampler/quantization provenance - never derived\nfrom the content hash), the self-covering content hash, and the\nauthoritative recorded ``realized_at`` (the campaign ``created_at``\n- never the wall clock).\n\nDigest-word draw indexes are contiguous: sampled values are ordered\nby ``draw_index``, the first begins at zero, and every next index\nequals the previous index plus the previous ``draw_count``, so the\nranges partition ``[0, total_words)`` with no gaps or overlaps.",
      "properties": {
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "identifier": {
          "title": "Identifier",
          "type": "string"
        },
        "quantization_fraction_bits": {
          "const": 64,
          "title": "Quantization Fraction Bits",
          "type": "integer"
        },
        "quantization_policy": {
          "const": "rational-round-half-even",
          "title": "Quantization Policy",
          "type": "string"
        },
        "realized_at": {
          "format": "date-time",
          "title": "Realized At",
          "type": "string"
        },
        "realized_initial_state_overrides": {
          "items": {
            "$ref": "#/$defs/RealizedStateFieldValue"
          },
          "title": "Realized Initial State Overrides",
          "type": "array"
        },
        "sampled_values": {
          "items": {
            "$ref": "#/$defs/SampledStateFieldValue"
          },
          "title": "Sampled Values",
          "type": "array"
        },
        "sampler_version": {
          "const": "sha256-counter-v1",
          "title": "Sampler Version",
          "type": "string"
        },
        "scenario_id": {
          "minLength": 1,
          "title": "Scenario Id",
          "type": "string"
        },
        "scenario_seed_id": {
          "minLength": 1,
          "title": "Scenario Seed Id",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0.0",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Schema Version",
          "type": "string"
        },
        "seed_content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Seed Content Hash",
          "type": "string"
        },
        "tenant_id": {
          "title": "Tenant Id",
          "type": "string"
        },
        "uncertainty_model_content_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uncertainty Model Content Hash"
        },
        "uncertainty_model_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uncertainty Model Id"
        },
        "world_content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "World Content Hash",
          "type": "string"
        },
        "world_version_id": {
          "minLength": 1,
          "title": "World Version Id",
          "type": "string"
        }
      },
      "required": [
        "identifier",
        "tenant_id",
        "scenario_id",
        "world_version_id",
        "world_content_hash",
        "scenario_seed_id",
        "seed_content_hash",
        "sampler_version",
        "quantization_policy",
        "quantization_fraction_bits",
        "content_hash",
        "realized_at"
      ],
      "title": "WorldRealization",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The deterministic world-realization matrix of one campaign.\n\nExactly one ``WorldRealization`` per campaign seed, in the exact\ncampaign seed-ensemble order, with complete world/model/sampler\nprovenance. Strategy identifiers appear nowhere: realizations are\nintentionally strategy-independent, so the matrix is a pure\nfunction of the campaign identity, the compiled world, the embedded\nuncertainty model (or its absence), and the seed ensemble - never\nof execution status or strategy count/order. The identifier is\nindependently derived from the canonical\ncampaign/world/model/sampler identity (never from the content\nhash), the content hash covers the complete canonical serialization\nexcluding itself, and ``assembled_at`` is the authoritative\nrecorded campaign ``created_at``. The matrix is derived in memory\nand never stored.",
  "properties": {
    "assembled_at": {
      "format": "date-time",
      "title": "Assembled At",
      "type": "string"
    },
    "campaign_id": {
      "minLength": 1,
      "title": "Campaign Id",
      "type": "string"
    },
    "content_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Hash",
      "type": "string"
    },
    "identifier": {
      "title": "Identifier",
      "type": "string"
    },
    "ordered_scenario_seed_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Ordered Scenario Seed Ids",
      "type": "array"
    },
    "quantization_fraction_bits": {
      "const": 64,
      "title": "Quantization Fraction Bits",
      "type": "integer"
    },
    "quantization_policy": {
      "const": "rational-round-half-even",
      "title": "Quantization Policy",
      "type": "string"
    },
    "realizations": {
      "items": {
        "$ref": "#/$defs/WorldRealization"
      },
      "minItems": 1,
      "title": "Realizations",
      "type": "array"
    },
    "sampler_version": {
      "const": "sha256-counter-v1",
      "title": "Sampler Version",
      "type": "string"
    },
    "scenario_id": {
      "minLength": 1,
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "tenant_id": {
      "title": "Tenant Id",
      "type": "string"
    },
    "uncertainty_model_content_hash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Uncertainty Model Content Hash"
    },
    "uncertainty_model_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Uncertainty Model Id"
    },
    "world_content_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "World Content Hash",
      "type": "string"
    },
    "world_version_id": {
      "minLength": 1,
      "title": "World Version Id",
      "type": "string"
    }
  },
  "required": [
    "identifier",
    "tenant_id",
    "campaign_id",
    "scenario_id",
    "world_version_id",
    "world_content_hash",
    "sampler_version",
    "quantization_policy",
    "quantization_fraction_bits",
    "ordered_scenario_seed_ids",
    "realizations",
    "content_hash",
    "assembled_at"
  ],
  "title": "CampaignWorldRealizationMatrix",
  "type": "object"
}
