{
  "additionalProperties": false,
  "description": "Immutable attestation of an exact independent runtime-4 replay.\n\nThe manifest is persisted as a top-level authority, never nested\nevidence. The external observation input bundle identifier and content\nhash are both present or both absent (external provenance is\noptional). ``replayed_at`` is deterministic authority time and is\nlater required to equal ``RunPlan.created_at``; no wall clock exists\nin this contract. ``content_hash`` is required but is never computed\nhere, and ``expected_execution_hash`` is never compared with\n``recomputed_execution_hash`` inside this contract.",
  "properties": {
    "adaptive_policy_content_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Adaptive Policy Content Hash",
      "type": "string"
    },
    "adaptive_policy_identifier": {
      "minLength": 1,
      "title": "Adaptive Policy Identifier",
      "type": "string"
    },
    "adaptive_run_trajectory_execution_id": {
      "minLength": 1,
      "title": "Adaptive Run Trajectory Execution Id",
      "type": "string"
    },
    "campaign_id": {
      "minLength": 1,
      "title": "Campaign Id",
      "type": "string"
    },
    "content_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Hash",
      "type": "string"
    },
    "expected_execution_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Expected Execution Hash",
      "type": "string"
    },
    "external_observation_input_bundle_content_hash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "External Observation Input Bundle Content Hash"
    },
    "external_observation_input_bundle_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "External Observation Input Bundle Id"
    },
    "identifier": {
      "title": "Identifier",
      "type": "string"
    },
    "input_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Hash",
      "type": "string"
    },
    "policy_id": {
      "minLength": 1,
      "title": "Policy Id",
      "type": "string"
    },
    "recomputed_execution_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Recomputed Execution Hash",
      "type": "string"
    },
    "replay_classification": {
      "const": "exact",
      "default": "exact",
      "title": "Replay Classification",
      "type": "string"
    },
    "replayed_at": {
      "format": "date-time",
      "title": "Replayed At",
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "runtime_version": {
      "const": "4.0.0",
      "title": "Runtime Version",
      "type": "string"
    },
    "scenario_seed_id": {
      "minLength": 1,
      "title": "Scenario Seed Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "seed_content_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Seed Content Hash",
      "type": "string"
    },
    "tenant_id": {
      "title": "Tenant Id",
      "type": "string"
    },
    "trajectory_plan_set_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Trajectory Plan Set Hash",
      "type": "string"
    },
    "world_content_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "World Content Hash",
      "type": "string"
    },
    "world_realization_content_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "World Realization Content Hash",
      "type": "string"
    },
    "world_realization_id": {
      "minLength": 1,
      "title": "World Realization Id",
      "type": "string"
    },
    "world_version_id": {
      "minLength": 1,
      "title": "World Version Id",
      "type": "string"
    }
  },
  "required": [
    "identifier",
    "tenant_id",
    "run_id",
    "campaign_id",
    "adaptive_run_trajectory_execution_id",
    "world_version_id",
    "world_content_hash",
    "scenario_seed_id",
    "seed_content_hash",
    "world_realization_id",
    "world_realization_content_hash",
    "adaptive_policy_identifier",
    "policy_id",
    "adaptive_policy_content_hash",
    "runtime_version",
    "input_hash",
    "trajectory_plan_set_hash",
    "expected_execution_hash",
    "recomputed_execution_hash",
    "replayed_at",
    "content_hash"
  ],
  "title": "AdaptiveRunTrajectoryReplayManifest",
  "type": "object"
}
