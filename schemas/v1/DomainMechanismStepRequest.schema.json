{
  "$defs": {
    "JsonValue": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "MechanismExogenousInput": {
      "additionalProperties": false,
      "description": "One ordered, coordinate-addressed exogenous input value.\n\nThe complete recorded coordinate binds the request's world, seed,\noptional realization, run, and step identity plus the stream,\nvariable, exactly one of entity or slot, and the non-negative draw\nindex, so mechanism branching, call order, retries, or scheduling\ncannot shift unrelated draws. The value is exact and finite per its\ndeclared kind: integer kinds require an exact ``int``; number kinds\naccept an exact finite ``int`` or ``float`` without conversion. The\n``content_hash`` is the caller-declared content hash of this entry's\nvalue.",
      "properties": {
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "draw_index": {
          "minimum": 0,
          "title": "Draw Index",
          "type": "integer"
        },
        "entity_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entity Id"
        },
        "identifier": {
          "minLength": 1,
          "title": "Identifier",
          "type": "string"
        },
        "realization_content_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Realization Content Hash"
        },
        "realization_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Realization Id"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "seed_content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Seed Content Hash",
          "type": "string"
        },
        "seed_id": {
          "minLength": 1,
          "title": "Seed Id",
          "type": "string"
        },
        "slot_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Slot Id"
        },
        "step_index": {
          "minimum": 0,
          "title": "Step Index",
          "type": "integer"
        },
        "stream": {
          "minLength": 1,
          "title": "Stream",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "value": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            }
          ],
          "title": "Value"
        },
        "value_kind": {
          "enum": [
            "integer",
            "number"
          ],
          "title": "Value Kind",
          "type": "string"
        },
        "variable": {
          "minLength": 1,
          "title": "Variable",
          "type": "string"
        },
        "world_content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "World Content Hash",
          "type": "string"
        },
        "world_version_id": {
          "minLength": 1,
          "title": "World Version Id",
          "type": "string"
        }
      },
      "required": [
        "identifier",
        "stream",
        "variable",
        "draw_index",
        "value_kind",
        "value",
        "content_hash",
        "world_version_id",
        "world_content_hash",
        "seed_id",
        "seed_content_hash",
        "run_id",
        "step_index"
      ],
      "title": "MechanismExogenousInput",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Immutable step request: verified state, action, exogenous inputs,\nconfiguration.\n\nRepresents exactly ``verified state + validated action + ordered\ncoordinate-addressed exogenous inputs + immutable configuration``.\nBinds the mechanism-spec reference, the required opaque release-\nprofile identity reference (id and content hash - never a partial\nreference, and never an implementation of that profile), the\nscenario/world/seed/run/step identity, the copied state, action, and\nconfiguration schema identities, the three payloads with their\ncontent hashes, and the canonically ordered exogenous entries. Every\nentry must copy and match the request's world, seed,\noptional-realization, run, and step identity, carry a unique\nidentifier and a unique complete coordinate, and appear in the\ndocumented canonical coordinate order ``(stream, variable,\nsubject_kind, subject, draw_index)``; noncanonical order is rejected\ninstead of being sorted. Empty exogenous input is valid. There is no\ntimestamp and no wall-clock authority anywhere in a request.",
  "properties": {
    "action_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Action Hash",
      "type": "string"
    },
    "action_payload": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Action Payload",
      "type": "object"
    },
    "action_schema_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Action Schema Hash",
      "type": "string"
    },
    "action_schema_id": {
      "minLength": 1,
      "title": "Action Schema Id",
      "type": "string"
    },
    "configuration_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Configuration Hash",
      "type": "string"
    },
    "configuration_payload": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Configuration Payload",
      "type": "object"
    },
    "configuration_schema_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Configuration Schema Hash",
      "type": "string"
    },
    "configuration_schema_id": {
      "minLength": 1,
      "title": "Configuration Schema Id",
      "type": "string"
    },
    "content_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Hash",
      "type": "string"
    },
    "exogenous_inputs": {
      "items": {
        "$ref": "#/$defs/MechanismExogenousInput"
      },
      "title": "Exogenous Inputs",
      "type": "array"
    },
    "identifier": {
      "title": "Identifier",
      "type": "string"
    },
    "mechanism_spec_content_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Mechanism Spec Content Hash",
      "type": "string"
    },
    "mechanism_spec_id": {
      "minLength": 1,
      "title": "Mechanism Spec Id",
      "type": "string"
    },
    "realization_content_hash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Realization Content Hash"
    },
    "realization_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Realization Id"
    },
    "release_profile_content_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Release Profile Content Hash",
      "type": "string"
    },
    "release_profile_id": {
      "minLength": 1,
      "title": "Release Profile Id",
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "scenario_content_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Scenario Content Hash",
      "type": "string"
    },
    "scenario_id": {
      "minLength": 1,
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "seed_content_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Seed Content Hash",
      "type": "string"
    },
    "seed_id": {
      "minLength": 1,
      "title": "Seed Id",
      "type": "string"
    },
    "state_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "State Hash",
      "type": "string"
    },
    "state_payload": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "State Payload",
      "type": "object"
    },
    "state_schema_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "State Schema Hash",
      "type": "string"
    },
    "state_schema_id": {
      "minLength": 1,
      "title": "State Schema Id",
      "type": "string"
    },
    "step_index": {
      "minimum": 0,
      "title": "Step Index",
      "type": "integer"
    },
    "tenant_id": {
      "title": "Tenant Id",
      "type": "string"
    },
    "world_content_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "World Content Hash",
      "type": "string"
    },
    "world_version_id": {
      "minLength": 1,
      "title": "World Version Id",
      "type": "string"
    }
  },
  "required": [
    "identifier",
    "tenant_id",
    "mechanism_spec_id",
    "mechanism_spec_content_hash",
    "release_profile_id",
    "release_profile_content_hash",
    "scenario_id",
    "scenario_content_hash",
    "world_version_id",
    "world_content_hash",
    "seed_id",
    "seed_content_hash",
    "run_id",
    "step_index",
    "state_schema_id",
    "action_schema_id",
    "configuration_schema_id",
    "state_schema_hash",
    "action_schema_hash",
    "configuration_schema_hash",
    "state_hash",
    "action_hash",
    "configuration_hash",
    "content_hash"
  ],
  "title": "DomainMechanismStepRequest",
  "type": "object"
}
