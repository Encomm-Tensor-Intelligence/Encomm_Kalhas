{
  "additionalProperties": false,
  "description": "Attestation that a run's recorded inputs verified exactly.\n\nThe manifest attests **deterministic input verification**, not a\nreal-time audit event: ``recorded_at`` is the recorded RunPlan creation\ntime (derived from recorded inputs), never the wall clock. Both hashes\nare the deterministic SHA-256 input digests (lowercase, 64 hex chars);\n``verification_classification`` is always ``\"exact\"``.",
  "properties": {
    "campaign_id": {
      "title": "Campaign Id",
      "type": "string"
    },
    "expected_input_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Expected Input Hash",
      "type": "string"
    },
    "identifier": {
      "title": "Identifier",
      "type": "string"
    },
    "recomputed_input_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Recomputed Input Hash",
      "type": "string"
    },
    "recorded_at": {
      "format": "date-time",
      "title": "Recorded At",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "run_plan_id": {
      "title": "Run Plan Id",
      "type": "string"
    },
    "runtime_version": {
      "title": "Runtime Version",
      "type": "string"
    },
    "scenario_seed_id": {
      "title": "Scenario Seed Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "strategy_candidate_id": {
      "title": "Strategy Candidate Id",
      "type": "string"
    },
    "tenant_id": {
      "title": "Tenant Id",
      "type": "string"
    },
    "verification_classification": {
      "const": "exact",
      "default": "exact",
      "title": "Verification Classification",
      "type": "string"
    },
    "world_version_id": {
      "title": "World Version Id",
      "type": "string"
    }
  },
  "required": [
    "identifier",
    "tenant_id",
    "run_id",
    "campaign_id",
    "run_plan_id",
    "world_version_id",
    "strategy_candidate_id",
    "scenario_seed_id",
    "runtime_version",
    "expected_input_hash",
    "recomputed_input_hash",
    "recorded_at"
  ],
  "title": "RunInputIntegrityManifest",
  "type": "object"
}
