{
  "$defs": {
    "RunMetricObservationValue": {
      "additionalProperties": false,
      "description": "One immutable raw metric observation extracted from a verified final state.\n\nCarries the exact provenance required to prove where the value came\nfrom: the metric identity and its unit (copied from the authoritative\nembedded ``ScenarioSpec`` when declared), the observation binding\nidentifier and content hash, the manifest and state-model\nidentity/content hashes, the observed state field and its\nauthoritative numeric value kind, the observation point (exactly\n``\"final_state\"``), the trajectory-plan identity/content hash and the\nexact result content hash required to locate the authoritative final\nstate inside the verified ``RunTrajectoryExecution``, and the exact\nfinite ``raw_value`` read from ``final_state[state_field_id]`` - with\nno normalization, scaling, transformation, or unit conversion.\n\nThe value is raw extraction data only: nothing here aggregates,\nscores, ranks, produces outcomes/evidence/recommendations, or\nexecutes anything.",
      "properties": {
        "binding_content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Binding Content Hash",
          "type": "string"
        },
        "binding_id": {
          "minLength": 1,
          "title": "Binding Id",
          "type": "string"
        },
        "manifest_id": {
          "minLength": 1,
          "title": "Manifest Id",
          "type": "string"
        },
        "metric_id": {
          "minLength": 1,
          "title": "Metric Id",
          "type": "string"
        },
        "metric_unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metric Unit"
        },
        "observation_point": {
          "const": "final_state",
          "default": "final_state",
          "title": "Observation Point",
          "type": "string"
        },
        "raw_value": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            }
          ],
          "title": "Raw Value"
        },
        "state_field_id": {
          "minLength": 1,
          "title": "State Field Id",
          "type": "string"
        },
        "state_field_value_kind": {
          "enum": [
            "integer",
            "number"
          ],
          "title": "State Field Value Kind",
          "type": "string"
        },
        "state_model_content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "State Model Content Hash",
          "type": "string"
        },
        "state_model_id": {
          "minLength": 1,
          "title": "State Model Id",
          "type": "string"
        },
        "state_model_identifier": {
          "minLength": 1,
          "title": "State Model Identifier",
          "type": "string"
        },
        "trajectory_plan_content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Trajectory Plan Content Hash",
          "type": "string"
        },
        "trajectory_plan_id": {
          "minLength": 1,
          "title": "Trajectory Plan Id",
          "type": "string"
        },
        "trajectory_result_content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Trajectory Result Content Hash",
          "type": "string"
        }
      },
      "required": [
        "metric_id",
        "binding_id",
        "binding_content_hash",
        "manifest_id",
        "state_model_identifier",
        "state_model_id",
        "state_model_content_hash",
        "state_field_id",
        "state_field_value_kind",
        "trajectory_plan_id",
        "trajectory_plan_content_hash",
        "trajectory_result_content_hash",
        "raw_value"
      ],
      "title": "RunMetricObservationValue",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The complete immutable raw metric-observation collection of one run.\n\nExactly one artifact per tenant + run: the run/campaign/plan/scenario\nidentity, the verified compiled world and the exact recorded strategy\nwith their content hashes, the recorded seed identity, the trajectory\nruntime version (exactly ``\"2.0.0\"``), the run input hash, the\nverified ``RunTrajectoryExecution`` identifier and content hash, the\nexact ordered observation tuple canonicalized by ``metric_id``, the\ndeterministic ``content_hash`` over the complete canonical payload\nexcluding ``content_hash`` itself, and the deterministic\n``observed_at`` from the authoritative execution's ``executed_at`` -\nnever the wall clock. The identifier is deterministically derived\nfrom the stable run/runtime identity. An empty observation tuple is\nvalid only for a verified compiled world with no observation binding\nsnapshots.\n\nThe set is raw extraction and provenance recording only: it never\naggregates observations, calculates outcomes or distributions,\nproduces evidence, scores, rankings, or recommendations, and nothing\nhere loads or executes a domain pack.",
  "properties": {
    "campaign_id": {
      "minLength": 1,
      "title": "Campaign Id",
      "type": "string"
    },
    "content_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Hash",
      "type": "string"
    },
    "identifier": {
      "title": "Identifier",
      "type": "string"
    },
    "input_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Hash",
      "type": "string"
    },
    "observations": {
      "items": {
        "$ref": "#/$defs/RunMetricObservationValue"
      },
      "title": "Observations",
      "type": "array"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "run_plan_id": {
      "minLength": 1,
      "title": "Run Plan Id",
      "type": "string"
    },
    "runtime_version": {
      "const": "2.0.0",
      "title": "Runtime Version",
      "type": "string"
    },
    "scenario_id": {
      "minLength": 1,
      "title": "Scenario Id",
      "type": "string"
    },
    "scenario_seed_id": {
      "minLength": 1,
      "title": "Scenario Seed Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "strategy_candidate_id": {
      "minLength": 1,
      "title": "Strategy Candidate Id",
      "type": "string"
    },
    "strategy_content_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Strategy Content Hash",
      "type": "string"
    },
    "tenant_id": {
      "title": "Tenant Id",
      "type": "string"
    },
    "trajectory_execution_content_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Trajectory Execution Content Hash",
      "type": "string"
    },
    "trajectory_execution_id": {
      "minLength": 1,
      "title": "Trajectory Execution Id",
      "type": "string"
    },
    "world_content_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "World Content Hash",
      "type": "string"
    },
    "world_version_id": {
      "minLength": 1,
      "title": "World Version Id",
      "type": "string"
    }
  },
  "required": [
    "identifier",
    "tenant_id",
    "run_id",
    "campaign_id",
    "run_plan_id",
    "scenario_id",
    "world_version_id",
    "world_content_hash",
    "strategy_candidate_id",
    "strategy_content_hash",
    "scenario_seed_id",
    "runtime_version",
    "input_hash",
    "trajectory_execution_id",
    "trajectory_execution_content_hash",
    "content_hash",
    "observed_at"
  ],
  "title": "RunMetricObservationSet",
  "type": "object"
}
