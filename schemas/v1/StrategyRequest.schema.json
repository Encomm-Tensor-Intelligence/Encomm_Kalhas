{
  "$defs": {
    "JsonValue": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "ObservationRequirement": {
      "additionalProperties": false,
      "description": "A required observation of a metric.",
      "properties": {
        "description": {
          "title": "Description",
          "type": "string"
        },
        "metric_id": {
          "title": "Metric Id",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        }
      },
      "required": [
        "metric_id",
        "description"
      ],
      "title": "ObservationRequirement",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A request for strategy generation, addressed through the LegionAdapter.",
  "properties": {
    "constraint_ids": {
      "items": {
        "type": "string"
      },
      "title": "Constraint Ids",
      "type": "array"
    },
    "context_bundle_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Context Bundle Id"
    },
    "identifier": {
      "title": "Identifier",
      "type": "string"
    },
    "metadata": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Metadata",
      "type": "object"
    },
    "requested_at": {
      "format": "date-time",
      "title": "Requested At",
      "type": "string"
    },
    "required_observations": {
      "items": {
        "$ref": "#/$defs/ObservationRequirement"
      },
      "title": "Required Observations",
      "type": "array"
    },
    "scenario_id": {
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "tenant_id": {
      "title": "Tenant Id",
      "type": "string"
    }
  },
  "required": [
    "identifier",
    "tenant_id",
    "scenario_id",
    "requested_at"
  ],
  "title": "StrategyRequest",
  "type": "object"
}
