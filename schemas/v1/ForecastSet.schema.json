{
  "$defs": {
    "ForecastFile": {
      "additionalProperties": false,
      "properties": {
        "byte_size": {
          "maximum": 26214400,
          "minimum": 1,
          "title": "Byte Size",
          "type": "integer"
        },
        "path": {
          "const": "forecasts.csv",
          "title": "Path",
          "type": "string"
        },
        "row_count": {
          "minimum": 0,
          "title": "Row Count",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256",
        "byte_size",
        "row_count"
      ],
      "title": "ForecastFile",
      "type": "object"
    },
    "ForecastProducer": {
      "additionalProperties": false,
      "properties": {
        "configuration_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Configuration Hash",
          "type": "string"
        },
        "kind": {
          "enum": [
            "baseline",
            "model_pack_mechanism"
          ],
          "title": "Kind",
          "type": "string"
        },
        "producer_id": {
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Producer Id",
          "type": "string"
        },
        "producer_version": {
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Producer Version",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "producer_id",
        "producer_version",
        "configuration_hash"
      ],
      "title": "ForecastProducer",
      "type": "object"
    },
    "JsonValue": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "description": "A protocol-bound forecast file and its immutable producer identity.",
  "properties": {
    "content_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Hash",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "forecast_set_id": {
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "title": "Forecast Set Id",
      "type": "string"
    },
    "forecast_set_version": {
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Forecast Set Version",
      "type": "string"
    },
    "forecasts_file": {
      "$ref": "#/$defs/ForecastFile"
    },
    "identifier": {
      "title": "Identifier",
      "type": "string"
    },
    "metadata": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Metadata",
      "type": "object"
    },
    "partition": {
      "enum": [
        "development",
        "validation",
        "holdout"
      ],
      "title": "Partition",
      "type": "string"
    },
    "producer": {
      "$ref": "#/$defs/ForecastProducer"
    },
    "protocol_content_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Protocol Content Hash",
      "type": "string"
    },
    "protocol_manifest_id": {
      "minLength": 1,
      "title": "Protocol Manifest Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "tenant_id": {
      "title": "Tenant Id",
      "type": "string"
    }
  },
  "required": [
    "identifier",
    "tenant_id",
    "forecast_set_id",
    "forecast_set_version",
    "protocol_manifest_id",
    "protocol_content_hash",
    "partition",
    "producer",
    "forecasts_file",
    "created_at",
    "content_hash"
  ],
  "title": "ForecastSet",
  "type": "object"
}
