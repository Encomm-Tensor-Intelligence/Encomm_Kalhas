      "kind": "http",
      "method": "POST",
      "path": "/v1/scenarios/scenario-1/domain-state-transitions",
      "body": {
        "manifest_id": "manifest-1",
        "state_model_id": "lab-state",
        "transition_id": "set-low",
        "description": "Set synthetic level",
        "guard_values": {},
        "target_values": {
          "level": 2
        },
        "declared_at": "2026-01-01T12:00:00Z"
      },
      "expect_status": 201,
      "capture": {}
    },
    {
      "id": "set-mid",
      "stage": "World",
      "title": "Declare set-mid",
      "kind": "http",
      "method": "POST",
      "path": "/v1/scenarios/scenario-1/domain-state-transitions",
      "body": {
        "manifest_id": "manifest-1",
        "state_model_id": "lab-state",
        "transition_id": "set-mid",
        "description": "Set synthetic level",
        "guard_values": {},
        "target_values": {
          "level": 5
        },
        "declared_at": "2026-01-01T12:00:00Z"
      },
      "expect_status": 201,
      "capture": {}
    },
    {
      "id": "set-high",
      "stage": "World",
      "title": "Declare set-high",
      "kind": "http",
      "method": "POST",
      "path": "/v1/scenarios/scenario-1/domain-state-transitions",
      "body": {
        "manifest_id": "manifest-1",
        "state_model_id": "lab-state",
        "transition_id": "set-high",
        "description": "Set synthetic level",
        "guard_values": {},
        "target_values": {
          "level": 9
