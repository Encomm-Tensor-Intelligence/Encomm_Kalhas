      "kind": "http",
      "method": "POST",
      "path": "/v1/scenarios/scenario-1/domain-state-models",
      "body": {
        "manifest_id": "manifest-1",
        "state_model_id": "lab-state",
        "state_fields": [
          {
            "identifier": "level",
            "description": "Synthetic level",
            "value_kind": "integer",
            "initial_value": 0,
            "metadata": {}
          }
        ],
        "declared_at": "2026-01-01T12:00:00Z"
      },
      "expect_status": 201,
      "capture": {}
    },
    {
      "id": "set-low",
