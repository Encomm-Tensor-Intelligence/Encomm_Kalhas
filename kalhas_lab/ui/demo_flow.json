      "kind": "http",
      "method": "POST",
      "path": "/v1/scenarios/scenario-1/evaluation-profile",
      "body": {
        "bindings": [
          {
            "objective_id": "obj-1",
            "metric_id": "m-1",
            "normalization_scale": 10.0
          }
        ],
        "declared_at": "2026-01-01T12:00:00Z"
      },
      "expect_status": 201,
      "capture": {}
    },
    {
      "id": "uncertainty",
      "stage": "World",
      "title": "Declare uncertainty",
      "kind": "http",
      "method": "POST",
      "path": "/v1/scenarios/scenario-1/uncertainty-model",
      "body": {
        "bindings": [
          {
            "manifest_id": "manifest-1",
            "state_model_id": "lab-state",
            "state_field_id": "level",
            "distribution": {
              "kind": "uniform",
              "low": 0.0,
              "high": 8.0
            },
            "rounding_policy": "nearest_ties_to_even"
          }
        ],
        "declared_at": "2026-01-01T12:00:00Z"
      },
      "expect_status": 201,
      "capture": {}
    },
    {
