    {
      "id": "metric-binding",
      "stage": "World",
      "title": "Bind metric",
      "kind": "http",
      "method": "POST",
      "path": "/v1/scenarios/scenario-1/metric-observations",
      "body": {
        "manifest_id": "manifest-1",
        "state_model_id": "lab-state",
