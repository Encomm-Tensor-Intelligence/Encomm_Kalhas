{
  "flow_version": "1.0.0",
  "steps": [
    {
      "id": "scenario",
      "stage": "Scenario",
      "title": "Register scenario",
      "kind": "http",
      "method": "POST",
      "path": "/v1/scenarios",
      "body": {
        "identifier": "scenario-1",
        "tenant_id": "{tenant}",
        "schema_version": "1.0.0",
        "name": "Synthetic capacity scenario",
        "created_at": "2026-01-01T12:00:00Z",
        "objectives": [
          {
            "identifier": "obj-1",
            "description": "Maximize the primary metric",
            "direction": "maximize",
            "target": 5.0,
            "weight": 1.0
          }
        ],
        "constraints": [
          {
            "identifier": "c-1",
            "description": "Stay within declared bounds"
          }
        ],
        "time_horizon": {
          "start": "2026-01-01T12:00:00Z",
          "end": "2026-01-02T12:00:00Z",
          "resolution": "step"
        },
        "metrics": [
          {
            "identifier": "m-1",
            "name": "Primary metric",
            "unit": "units"
          }
        ],
        "assumptions": [
          {
            "identifier": "a-1",
            "statement": "Conditions remain stable",
            "confidence": 0.9
          }
        ],
        "metadata": {}
      },
      "expect_status": 201,
      "capture": {}
    },
    {
      "id": "validate",
      "stage": "Scenario",
      "title": "Validate scenario",
      "kind": "http",
      "method": "POST",
      "path": "/v1/scenarios/scenario-1/validate",
      "body": null,
      "expect_status": 200,
      "capture": {}
    },
    {
      "id": "pack",
      "stage": "World",
      "title": "Register domain pack",
      "kind": "http",
      "method": "POST",
      "path": "/v1/domain-packs",
      "body": {
        "identifier": "manifest-1",
        "pack_id": "pack-1",
        "name": "Reference domain pack",
        "pack_version": "1.2.3",
        "description": "Declarative pack metadata only",
        "supported_api_versions": [
          "1"
        ],
        "capabilities": [
          {
            "identifier": "cap-1",
            "description": "Declared capability",
            "input_ids": [
              "in-a",
              "in-b"
            ],
            "output_ids": [
              "out-1"
            ],
            "metadata": {}
          }
        ],
        "schema_metadata": {
          "declarative": true
        },
        "created_at": "2026-01-01T12:00:00Z",
        "metadata": {}
      },
      "expect_status": 201,
      "capture": {}
    },
    {
      "id": "bind",
      "stage": "World",
      "title": "Bind pack",
      "kind": "http",
      "method": "POST",
      "path": "/v1/scenarios/scenario-1/domain-pack-bindings",
      "body": {
        "manifest_id": "manifest-1",
        "bound_at": "2026-01-01T12:00:00Z"
      },
      "expect_status": 201,
      "capture": {}
    },
    {
      "id": "capability",
      "stage": "World",
      "title": "Declare capability",
      "kind": "http",
      "method": "POST",
      "path": "/v1/scenarios/scenario-1/domain-capability-declarations",
      "body": {
        "manifest_id": "manifest-1",
        "capability_id": "cap-1",
        "input_values": {
          "in-a": "alpha",
          "in-b": 42
        },
        "declared_at": "2026-01-01T12:00:00Z"
      },
      "expect_status": 201,
      "capture": {}
    },
    {
