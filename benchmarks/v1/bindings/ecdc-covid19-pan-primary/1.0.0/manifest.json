      "sources": [
        {
          "basis": "assumption",
          "parameter": "compliance_bps",
          "reference": "ADR-012",
          "statement": "Zero, so the constant intervention intensity has no effect (ADR-012 D30-05-4)."
        },
        {
          "basis": "derived",
          "parameter": "exposed_per_infectious_bps",
          "reference": "Derived from the values above",
          "statement": "10000 x (infectious_recovery_bps + hospital_admission_bps) / exposed_progression_bps: the ratio at which E is in balance when R is 1."
        },
        {
          "basis": "source",
          "parameter": "exposed_progression_bps",
          "reference": "Salje H et al. Science 2020;369:208-211. doi:10.1126/science.abc3517",
          "statement": "10000 / 4: a mean non-infectious latent stage of about 4.0 days within a mean incubation period of 5 days."
        },
        {
          "basis": "source",
          "parameter": "hospital_admission_bps",
          "reference": "Salje H et al. Science 2020;369:208-211. doi:10.1126/science.abc3517",
          "statement": "infectious_recovery_bps x 26 / 974: an infection hospitalisation probability of 2.6 percent. It changed over time with vaccination and variants; this is not modelled."
        },
        {
          "basis": "assumption",
          "parameter": "hospital_capacity",
          "reference": "ADR-012",
          "statement": "Above every population in the denominator bundle, so capacity never binds (ADR-012 D30-05-4)."
        },
        {
          "basis": "source",
          "parameter": "hospital_recovery_bps",
          "reference": "Rees EM et al. BMC Med 2020;18:270. doi:10.1186/s12916-020-01726-3",
          "statement": "The hospital exit rate minus icu_admission_bps."
        },
        {
          "basis": "source",
          "parameter": "icu_admission_bps",
          "reference": "Salje H et al. 2020, and Rees EM et al. BMC Med 2020;18:270. doi:10.1186/s12916-020-01726-3",
          "statement": "18.2 percent of the hospital exit rate, which is 10000 x 0.693147 / 5, an exponential stay with the reported median of 5 days outside China."
        },
        {
          "basis": "assumption",
          "parameter": "icu_capacity",
          "reference": "ADR-012",
          "statement": "Above every population in the denominator bundle, so capacity never binds (ADR-012 D30-05-4)."
        },
        {
          "basis": "source",
          "parameter": "icu_mortality_bps",
          "reference": "Armstrong RA et al. Anaesthesia 2021;76:537-548. doi:10.1111/anae.15425, and Rees EM et al. 2020",
          "statement": "36 percent of the ICU exit rate, which is 10000 x 0.693147 / 7, an exponential stay with the reported median of 7 days outside China."
        },
        {
          "basis": "source",
          "parameter": "icu_recovery_bps",
          "reference": "Rees EM et al. BMC Med 2020;18:270. doi:10.1186/s12916-020-01726-3",
          "statement": "The ICU exit rate minus icu_mortality_bps."
        },
        {
          "basis": "derived",
          "parameter": "icu_share_bps",
          "reference": "Derived from the values above",
          "statement": "The steady-state ICU share implied by icu_admission_bps and the ICU exit rate: C over H for h-only, and C over H plus C for h-and-c."
        },
        {
          "basis": "assumption",
          "parameter": "immune_share_bps",
          "reference": "ADR-012 D30-05-10",
          "statement": "Zero. Under a constant schedule immunity cannot be told apart from transmission, so its effect is absorbed by transmission_bps. No result supports any claim about immunity."
        },
        {
          "basis": "derived",
          "parameter": "infectious_per_hospitalized_bps",
          "reference": "Derived from the values above",
          "statement": "Half, one and two times the steady-state ratio 10000 x hospital exit rate / hospital_admission_bps, at which admissions balance hospital exits."
        },
        {
          "basis": "source",
          "parameter": "infectious_recovery_bps",
          "reference": "Byrne AW et al. BMJ Open 2020;10:e039856. doi:10.1136/bmjopen-2020-039856",
          "statement": "10000 / 7: a mean infectious period of 7 days, within the reported median of 6.5 to 9.5 days for asymptomatic cases."
        },
        {
          "basis": "derived",
          "parameter": "transmission_bps",
          "reference": "Flaxman S et al. Nature 2020;584:257-261. doi:10.1038/s41586-020-2405-7",
          "statement": "R x (infectious_recovery_bps + hospital_admission_bps) for R in 0.8, 1.0, 1.2 and 1.4, half-even. The R range is an assumption spanning declining to growing transmission, as reported for European countries in Flaxman et al. 2020."
        }
      ],
